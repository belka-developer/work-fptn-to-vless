+++ b/src/fptn-vless/settings_store.h
@@ -0,0 +1,40 @@
+#pragma once
+
+/*
+ * What the program remembers between runs: the access token (encrypted for
+ * the current Windows user with DPAPI), the last chosen server and whether it
+ * was picked by hand. Stored in %APPDATA%\fptn-vless\settings.json.
+ */
+
+#include <string>
+
+namespace fptn::vless {
+
+struct Settings {
+  std::string token;   // empty = nothing saved
+  std::string server;  // server name chosen last time, may be empty
+  bool pinned = false;
+};
+
+class SettingsStore {
+ public:
+  explicit SettingsStore(std::string directory);
+
+  static std::string DefaultDirectory();
+
+  Settings Load() const;                 // missing/corrupt file = defaults
+  bool Save(const Settings& settings) const;
+  void Clear() const;                    // delete the file
+
+  [[nodiscard]] const std::string& Directory() const { return directory_; }
+
+ private:
+  std::string FilePath() const;
+  std::string directory_;
+};
+
+// Exposed for tests.
+std::string Base64Encode(const std::string& data);
+bool Base64Decode(const std::string& text, std::string& out);
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/test/app_test.cpp b/src/fptn-vless/test/app_test.cpp
new file mode 100644
index 0000000..043951e
--- /dev/null
+++ b/src/fptn-vless/test/app_test.cpp
@@ -0,0 +1,233 @@
+// The application state machine with a fake set of servers: token entry,
+// scanning, connecting, switching, disconnecting, remembering the token.
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <functional>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+#include <boost/asio.hpp>
+#include <nlohmann/json.hpp>
+
+#include "fptn-vless/app.h"
+
+using namespace fptn::vless;
+using namespace std::chrono_literals;
+namespace asio = boost::asio;
+using json = nlohmann::json;
+
+static int g_fail = 0;
+#define CHECK(cond, msg)                                         \
+  do {                                                           \
+    if (!(cond)) { std::printf("  FAIL: %s\n", msg); ++g_fail; }  \
+    else { std::printf("  ok:   %s\n", msg); }                    \
+  } while (0)
+
+struct FakeWorld {
+  std::mutex mu;
+  std::vector<PingMs> pings{300u, 50u, std::nullopt, 120u};
+  std::vector<std::size_t> connects;
+  bool down = false;
+  std::atomic<int> delay_ms{0};
+};
+
+class FakeTunnels : public ITunnels {
+ public:
+  explicit FakeTunnels(FakeWorld& w) : w_(w) {}
+  std::vector<std::string> Names() const override { return {"Alpha", "Bravo", "Charlie", "Delta"}; }
+  std::vector<PingMs> ProbeAll() override {
+    std::this_thread::sleep_for(std::chrono::milliseconds(w_.delay_ms.load()));
+    const std::lock_guard<std::mutex> l(w_.mu);
+    return w_.pings;
+  }
+  bool Connect(std::size_t i) override {
+    const std::lock_guard<std::mutex> l(w_.mu);
+    w_.connects.push_back(i);
+    return w_.pings[i].has_value();
+  }
+  bool IsDown() const override { return w_.down; }
+  void Shutdown() override {}
+ private:
+  FakeWorld& w_;
+};
+
+static json State(App& app) { return json::parse(app.StateJson()); }
+static bool WaitPhase(App& app, const std::string& phase, int ms = 5000) {
+  const auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(ms);
+  while (std::chrono::steady_clock::now() < end) {
+    const auto s = State(app);
+    if (s["phase"] == phase && s["busy"] == "") return true;
+    std::this_thread::sleep_for(20ms);
+  }
+  return false;
+}
+static bool PortOpen(int port) {
+  asio::io_context io;
+  boost::system::error_code ec;
+  asio::ip::tcp::socket s(io);
+  s.connect({asio::ip::make_address("127.0.0.1"), static_cast<std::uint16_t>(port)}, ec);
+  return !ec;
+}
+
+int main() {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  auto& stack = UserspaceStack::Instance();
+  UserspaceStack::Config sc;
+  sc.ipv4 = "10.0.0.1";
+  if (!stack.Start(sc)) return 2;
+
+  const auto dir = std::filesystem::temp_directory_path() / "fptn_app_test";
+  std::filesystem::remove_all(dir);
+  SettingsStore store(dir.string());
+
+  asio::io_context ioc;
+  auto guard = asio::make_work_guard(ioc);
+  std::thread io([&] { ioc.run(); });
+
+  FakeWorld world;
+  AppOptions options;
+  options.failover.scan_interval = 0ms;
+  options.listen = "127.0.0.1";
+  options.port = 18950;
+  AppDeps deps;
+  deps.make_tunnels = [&](const std::string& token) -> std::unique_ptr<ITunnels> {
+    if (token.rfind("fptnb:", 0) != 0) throw std::runtime_error("bad token");
+    return std::make_unique<FakeTunnels>(world);
+  };
+  deps.lan_hosts = []() { return std::vector<std::string>{"192.168.0.10", "10.1.1.1"}; };
+  deps.full_check = []() { return std::string("Tunnel check: fake"); };
+
+  {
+    App app(ioc, stack, store, options, deps);
+
+    std::puts("[1] first start without a token");
+    app.Start(std::nullopt);
+    CHECK(WaitPhase(app, "no_token"), "waits for a token");
+    CHECK(app.HandlePost("token", "", "  \n ") == 400, "empty token is a bad request");
+
+    std::puts("[2] wrong token");
+    CHECK(app.HandlePost("token", "remember=1", "garbage") == 202, "token accepted for processing");
+    CHECK(WaitPhase(app, "no_token"), "back to the token form");
+    CHECK(State(app)["message"].get<std::string>().find("bad token") != std::string::npos,
+        "the reason is shown");
+
+    std::puts("[3] good token (with quotes and line breaks from a paste)");
+    CHECK(app.HandlePost("token", "remember=1", "\"fptnb:AAA\n BBB\"") == 202, "accepted");
+    CHECK(WaitPhase(app, "ready"), "servers scanned -> ready");
+    auto s = State(app);
+    CHECK(s["servers"].size() == 4 && s["servers"][1]["ping"] == 50 && s["servers"][2]["ping"].is_null(),
+        "four servers with their response times");
+    CHECK(store.Load().token == "fptnb:AAABBB", "token remembered (cleaned)");
+    CHECK(s["active_index"] == -1 && !PortOpen(options.port), "not connected, no listener yet");
+
+    std::puts("[4] connect to the fastest");
+    CHECK(app.HandlePost("connect", "auto=1", "") == 202, "connect started");
+    CHECK(WaitPhase(app, "connected"), "connected");
+    s = State(app);
+    CHECK(s["active_index"] == 1 && s["pinned"] == false, "the fastest server (Bravo), not pinned");
+    CHECK(s["links"].size() == 1 && s["links"][0]["url"].get<std::string>().find("@127.0.0.1:18950") != std::string::npos,
+        "a fixed --listen address goes into the link");
+    CHECK(PortOpen(options.port), "VLESS port is listening");
+    CHECK(s["check"] == "Tunnel check: fake", "tunnel check ran");
+
+    std::puts("[5] manual switch");
+    CHECK(app.HandlePost("connect", "i=3", "") == 202, "switch to Delta");
+    CHECK(WaitPhase(app, "connected"), "still connected");
+    s = State(app);
+    CHECK(s["active_index"] == 3 && s["pinned"] == true, "Delta, pinned by the user");
+    CHECK(store.Load().server == "Delta" && store.Load().pinned, "choice remembered");
+    CHECK(app.HandlePost("unpin", "", "") == 202 && State(app)["pinned"] == false, "unpin");
+
+    std::puts("[6] busy");
+    world.delay_ms = 400;
+    CHECK(app.HandlePost("rescan", "", "") == 202, "rescan started");
+    CHECK(app.HandlePost("disconnect", "", "") == 409, "second action while busy -> 409");
+    CHECK(State(app)["busy"] != "", "state says what is running");
+    CHECK(WaitPhase(app, "connected"), "rescan done");
+    world.delay_ms = 0;
+
+    std::puts("[7] disconnect");
+    CHECK(app.HandlePost("disconnect", "", "") == 202, "disconnect");
+    CHECK(WaitPhase(app, "ready"), "ready again");
+    s = State(app);
+    CHECK(s["active_index"] == -1 && s["servers"].size() == 4, "no active server, list kept");
+    CHECK(app.HandlePost("connect", "i=0", "") == 202 && WaitPhase(app, "connected") &&
+              State(app)["active_index"] == 0,
+        "reconnect to a chosen server works");
+    CHECK(app.HandlePost("connect", "i=2", "") == 202 && WaitPhase(app, "connected") &&
+              State(app)["active_index"] == 0,
+        "a server that does not answer cannot be selected: stays where it was");
+    CHECK(app.HandlePost("bogus", "", "") == 404, "unknown action -> 404");
+  }
+
+  std::puts("[8] restart: the saved token connects by itself");
+  {
+    // the last choice was Alpha (pinned by the user in [7])
+    App app(ioc, stack, store, options, deps);
+    app.Start(std::nullopt);
+    CHECK(WaitPhase(app, "connected"), "connected without any input");
+    const auto s = State(app);
+    CHECK(s["active_index"] == 0 && s["pinned"] == true, "the remembered server, pinned");
+    CHECK(s["token_saved"] == true, "token is marked as saved");
+
+    std::puts("[9] forget the token");
+    CHECK(app.HandlePost("forget", "", "") == 202, "forget");
+    CHECK(WaitPhase(app, "no_token"), "token form again");
+    CHECK(store.Load().token.empty(), "nothing left on disk");
+    CHECK(!PortOpen(options.port), "the listener is closed");
+  }
+
+  std::puts("[10] token not remembered");
+  {
+    App app(ioc, stack, store, options, deps);
+    app.Start(std::nullopt);
+    CHECK(WaitPhase(app, "no_token"), "starts empty");
+    app.HandlePost("token", "remember=0", "fptnb:ZZZ");
+    CHECK(WaitPhase(app, "ready") && store.Load().token.empty(), "works, but nothing is saved");
+  }
+
+  std::puts("[11] port already taken");
+  {
+    asio::io_context other;
+    asio::ip::tcp::acceptor taken(other, {asio::ip::make_address("127.0.0.1"), 18950});
+    App app(ioc, stack, store, options, deps);
+    app.Start(std::string("fptnb:QQQ"));  // from the command line
+    CHECK(WaitPhase(app, "ready"), "stays usable");
+    CHECK(State(app)["message"].get<std::string>().find("18950") != std::string::npos,
+        "the message names the port");
+  }
+
+  std::puts("[12] command-line server wins and is kept");
+  {
+    auto opts = options;
+    opts.preferred_server = "delta";
+    App app(ioc, stack, store, opts, deps);
+    app.Start(std::string("fptnb:QQQ"));
+    CHECK(WaitPhase(app, "connected") && State(app)["active_index"] == 3 && State(app)["pinned"] == true,
+        "--server Delta (any case) is used and pinned");
+  }
+
+  std::puts("[13] listening on the whole LAN: one link per detected address");
+  {
+    auto opts = options;
+    opts.listen = "0.0.0.0";
+    opts.port = 18951;
+    App app(ioc, stack, store, opts, deps);
+    app.Start(std::string("fptnb:QQQ"));
+    CHECK(WaitPhase(app, "connected"), "connected");
+    const auto s = State(app);
+    CHECK(s["links"].size() == 2 && s["links"][0]["host"] == "192.168.0.10", "links for the LAN addresses, best first");
+  }
+
+  std::filesystem::remove_all(dir);
+  std::printf("\n%s\n", g_fail ? "FAILED" : "ALL PASSED");
+  guard.reset();
+  ioc.stop();
+  io.join();
+  stack.Stop();
+  return g_fail ? 1 : 0;
+}
diff --git a/src/fptn-vless/test/dashboard_test.cpp b/src/fptn-vless/test/dashboard_test.cpp
new file mode 100644
index 0000000..9e33517
--- /dev/null
+++ b/src/fptn-vless/test/dashboard_test.cpp
@@ -0,0 +1,134 @@
+// The control page: routing and the two guards (Host header, CSRF header),
+// plus one real HTTP exchange over a socket.
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <string>
+#include <thread>
+
+#include <boost/asio.hpp>
+
+#include "fptn-vless/dashboard.h"
+
+using namespace fptn::vless;
+namespace asio = boost::asio;
+using asio::ip::tcp;
+
+static int g_fail = 0;
+#define CHECK(cond, msg)                                         \
+  do {                                                           \
+    if (!(cond)) { std::printf("  FAIL: %s\n", msg); ++g_fail; }  \
+    else { std::printf("  ok:   %s\n", msg); }                    \
+  } while (0)
+
+static bool Has(const std::string& s, const std::string& part) {
+  return s.find(part) != std::string::npos;
+}
+
+int main() {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  std::string last_action, last_query, last_body;
+  int answer = 202;
+  DashboardApi api;
+  api.state_json = []() { return std::string("{\"ok\":true}"); };
+  api.post = [&](const std::string& action, const std::string& query,
+                 const std::string& body) {
+    last_action = action;
+    last_query = query;
+    last_body = body;
+    return answer;
+  };
+
+  asio::io_context ioc;
+  const std::uint16_t port = 18901;
+  Dashboard d(ioc, port, api);
+
+  const std::string host = "Host: 127.0.0.1:18901\r\n";
+  const std::string post_ok = host + "X-Requested-With: fptn\r\n\r\n";
+
+  std::puts("[1] routing");
+  CHECK(Has(d.Handle("GET / HTTP/1.1\r\n" + host + "\r\n"), "200 OK") &&
+            Has(d.Handle("GET / HTTP/1.1\r\n" + host + "\r\n"), "<title>fptn-vless"),
+      "GET / serves the page");
+  CHECK(Has(d.Handle("GET /api/state HTTP/1.1\r\n" + host + "\r\n"), "{\"ok\":true}"),
+      "GET /api/state returns the state");
+  CHECK(Has(d.Handle("GET /nope HTTP/1.1\r\n" + host + "\r\n"), "404"), "unknown path: 404");
+  CHECK(Has(d.Handle("DELETE / HTTP/1.1\r\n" + host + "\r\n"), "405"), "other methods: 405");
+
+  std::puts("[2] actions");
+  CHECK(Has(d.Handle("POST /api/connect?i=7 HTTP/1.1\r\n" + post_ok), "202") &&
+            last_action == "connect" && last_query == "i=7",
+      "POST /api/connect?i=7 reaches the handler");
+  CHECK(Has(d.Handle("POST /api/token?remember=1 HTTP/1.1\r\n" + post_ok, "fptnb:abc"), "202") &&
+            last_action == "token" && last_body == "fptnb:abc",
+      "the body (token) is passed on");
+  answer = 409;
+  CHECK(Has(d.Handle("POST /api/rescan HTTP/1.1\r\n" + post_ok), "409"), "busy -> 409");
+  answer = 400;
+  CHECK(Has(d.Handle("POST /api/connect?i=x HTTP/1.1\r\n" + post_ok), "400"), "bad request -> 400");
+  answer = 404;
+  CHECK(Has(d.Handle("POST /api/nope HTTP/1.1\r\n" + post_ok), "404"), "unknown action -> 404");
+  CHECK(Has(d.Handle("POST /other HTTP/1.1\r\n" + post_ok), "404"), "POST outside /api/ -> 404");
+  answer = 202;
+
+  std::puts("[3] guards");
+  last_action.clear();
+  CHECK(Has(d.Handle("POST /api/connect?i=1 HTTP/1.1\r\n" + host + "\r\n"), "403") && last_action.empty(),
+      "POST without X-Requested-With is refused (CSRF)");
+  CHECK(Has(d.Handle("GET / HTTP/1.1\r\nHost: evil.example:18901\r\n\r\n"), "403"),
+      "foreign Host header is refused (DNS rebinding)");
+  CHECK(Has(d.Handle("GET / HTTP/1.1\r\n\r\n"), "403"), "missing Host header is refused");
+  CHECK(!Has(d.Handle("GET / HTTP/1.1\r\nhost: LOCALHOST:18901\r\n\r\n"), "403"),
+      "localhost:port is accepted, case-insensitive");
+
+  std::puts("[4] real socket");
+  CHECK(d.Start(), "listens on 127.0.0.1");
+  std::thread io([&] { ioc.run(); });
+  {
+    asio::io_context cio;
+    tcp::socket s(cio);
+    s.connect({asio::ip::make_address("127.0.0.1"), port});
+    const std::string req = "GET /api/state HTTP/1.1\r\n" + host + "Connection: close\r\n\r\n";
+    asio::write(s, asio::buffer(req));
+    std::string resp;
+    boost::system::error_code ec;
+    asio::read(s, asio::dynamic_buffer(resp), ec);
+    CHECK(Has(resp, "200 OK") && Has(resp, "{\"ok\":true}"), "full request/response over TCP");
+  }
+  {
+    asio::io_context cio;
+    tcp::socket s(cio);
+    s.connect({asio::ip::make_address("127.0.0.1"), port});
+    const std::string big(200000, 'x');  // a huge token, sent in pieces
+    const std::string req = "POST /api/token?remember=0 HTTP/1.1\r\n" + host +
+        "X-Requested-With: fptn\r\nContent-Length: " + std::to_string(big.size()) +
+        "\r\nConnection: close\r\n\r\n";
+    asio::write(s, asio::buffer(req));
+    for (std::size_t off = 0; off < big.size(); off += 30000) {
+      asio::write(s, asio::buffer(big.data() + off, std::min<std::size_t>(30000, big.size() - off)));
+    }
+    std::string resp;
+    boost::system::error_code ec;
+    asio::read(s, asio::dynamic_buffer(resp), ec);
+    CHECK(Has(resp, "202") && last_body == big, "POST with a 200 KB body arrives complete");
+  }
+  {
+    asio::io_context cio;
+    tcp::socket s(cio);
+    s.connect({asio::ip::make_address("127.0.0.1"), port});
+    const std::string req = "POST /api/token HTTP/1.1\r\n" + host +
+        "X-Requested-With: fptn\r\nContent-Length: 99999999\r\n\r\n";
+    asio::write(s, asio::buffer(req));
+    std::string resp;
+    boost::system::error_code ec;
+    asio::read(s, asio::dynamic_buffer(resp), ec);
+    CHECK(Has(resp, "413"), "absurd Content-Length is refused");
+  }
+  d.Stop();
+  ioc.stop();
+  io.join();
+
+  std::printf("\n%s\n", g_fail ? "FAILED" : "ALL PASSED");
+  return g_fail ? 1 : 0;
+}
diff --git a/src/fptn-vless/test/echo_peer.cpp b/src/fptn-vless/test/echo_peer.cpp
new file mode 100644
index 0000000..f569f2d
--- /dev/null
+++ b/src/fptn-vless/test/echo_peer.cpp
@@ -0,0 +1,132 @@
+// Test peer: a second lwIP instance (10.0.0.2) in its own process. It plays the
+// "remote host behind the FPTN server". IP packets travel over stdin/stdout as
+// frames: [u16 big-endian length][packet].
+//   port 7  : echo (small messages)
+//   port 9  : source - sends kSourceBytes of pattern (i % 251), then closes
+//   port 19 : sink   - counts bytes + byte sum, answers [u32 count][u32 sum] on FIN
+#include <poll.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+extern "C" {
+#include "lwip/init.h"
+#include "lwip/ip.h"
+#include "lwip/netif.h"
+#include "lwip/pbuf.h"
+#include "lwip/tcp.h"
+#include "lwip/timeouts.h"
+u32_t sys_now(void) {
+  static const auto t0 = std::chrono::steady_clock::now();
+  return (u32_t)std::chrono::duration_cast<std::chrono::milliseconds>(
+      std::chrono::steady_clock::now() - t0).count();
+}
+}
+
+static constexpr std::size_t kSourceBytes = 4 * 1024 * 1024;
+
+static bool WriteAll(int fd, const void* d, size_t n) {
+  const char* p = static_cast<const char*>(d);
+  while (n > 0) {
+    ssize_t w = write(fd, p, n);
+    if (w <= 0) return false;
+    p += w; n -= (size_t)w;
+  }
+  return true;
+}
+
+static err_t IpOut(struct netif*, struct pbuf* p, const ip4_addr_t*) {
+  std::vector<uint8_t> f(2 + p->tot_len);
+  f[0] = (uint8_t)(p->tot_len >> 8); f[1] = (uint8_t)p->tot_len;
+  pbuf_copy_partial(p, f.data() + 2, p->tot_len, 0);
+  WriteAll(1, f.data(), f.size());
+  return ERR_OK;
+}
+static err_t NetifInit(struct netif* n) {
+  n->name[0] = 'p'; n->name[1] = 'r'; n->output = IpOut; n->mtu = 1420;
+  n->flags = NETIF_FLAG_UP | NETIF_FLAG_LINK_UP; return ERR_OK;
+}
+
+struct Conn { uint16_t port; size_t sent = 0; uint32_t count = 0, sum = 0; };
+
+static void SourcePump(tcp_pcb* pcb, Conn* c) {
+  while (c->sent < kSourceBytes && tcp_sndbuf(pcb) > 0) {
+    size_t n = std::min<size_t>({tcp_sndbuf(pcb), kSourceBytes - c->sent, 8192});
+    std::vector<uint8_t> buf(n);
+    for (size_t i = 0; i < n; ++i) buf[i] = (uint8_t)((c->sent + i) % 251);
+    if (tcp_write(pcb, buf.data(), (u16_t)n, TCP_WRITE_FLAG_COPY) != ERR_OK) break;
+    c->sent += n;
+  }
+  tcp_output(pcb);
+  if (c->sent >= kSourceBytes) {
+    tcp_arg(pcb, nullptr); tcp_sent(pcb, nullptr); tcp_recv(pcb, nullptr);
+    tcp_close(pcb); delete c;
+  }
+}
+static err_t OnSent(void* a, tcp_pcb* pcb, u16_t) {
+  if (a) { SourcePump(pcb, static_cast<Conn*>(a)); }
+  return ERR_OK;
+}
+static err_t OnRecv(void* a, tcp_pcb* pcb, pbuf* p, err_t) {
+  Conn* c = static_cast<Conn*>(a);
+  if (!c) { if (p) pbuf_free(p); return ERR_OK; }
+  if (!p) {  // FIN
+    if (c->port == 19) {
+      uint8_t r[8] = {(uint8_t)(c->count >> 24), (uint8_t)(c->count >> 16), (uint8_t)(c->count >> 8), (uint8_t)c->count,
+                      (uint8_t)(c->sum >> 24), (uint8_t)(c->sum >> 16), (uint8_t)(c->sum >> 8), (uint8_t)c->sum};
+      tcp_write(pcb, r, 8, TCP_WRITE_FLAG_COPY); tcp_output(pcb);
+    }
+    tcp_arg(pcb, nullptr); tcp_recv(pcb, nullptr); tcp_close(pcb); delete c; return ERR_OK;
+  }
+  std::vector<uint8_t> d(p->tot_len); pbuf_copy_partial(p, d.data(), p->tot_len, 0);
+  u16_t len = p->tot_len; pbuf_free(p); tcp_recved(pcb, len);
+  if (c->port == 7) { tcp_write(pcb, d.data(), len, TCP_WRITE_FLAG_COPY); tcp_output(pcb); }
+  else if (c->port == 19) { c->count += len; for (auto b : d) c->sum += b; }
+  return ERR_OK;
+}
+static err_t OnAccept(void* a, tcp_pcb* pcb, err_t) {
+  uint16_t port = (uint16_t)(uintptr_t)a;
+  auto* c = new Conn{port};
+  tcp_arg(pcb, c); tcp_recv(pcb, OnRecv); tcp_sent(pcb, OnSent); tcp_nagle_disable(pcb);
+  if (port == 9) SourcePump(pcb, c);
+  return ERR_OK;
+}
+static void Listen(uint16_t port) {
+  tcp_pcb* l = tcp_new(); tcp_bind(l, IP_ANY_TYPE, port); l = tcp_listen(l);
+  tcp_arg(l, (void*)(uintptr_t)port); tcp_accept(l, OnAccept);
+}
+
+int main() {
+  lwip_init();
+  static netif nif; ip4_addr_t ip, mask, gw;
+  IP4_ADDR(&ip, 10, 0, 0, 2); IP4_ADDR(&mask, 255, 255, 255, 255); ip4_addr_set_zero(&gw);
+  netif_add(&nif, &ip, &mask, &gw, nullptr, NetifInit, ip_input);
+  netif_set_default(&nif); netif_set_up(&nif);
+  Listen(7); Listen(9); Listen(19);
+  std::vector<uint8_t> in; uint8_t tmp[65536];
+  for (;;) {
+    pollfd pfd{0, POLLIN, 0};
+    u32_t ms = sys_timeouts_sleeptime(); if (ms > 20) ms = 20;
+    int r = poll(&pfd, 1, (int)ms);
+    if (r > 0) {
+      ssize_t n = read(0, tmp, sizeof(tmp));
+      if (n <= 0) return 0;
+      in.insert(in.end(), tmp, tmp + n);
+      size_t off = 0;
+      while (in.size() - off >= 2) {
+        size_t len = ((size_t)in[off] << 8) | in[off + 1];
+        if (in.size() - off - 2 < len) break;
+        pbuf* p = pbuf_alloc(PBUF_RAW, (u16_t)len, PBUF_POOL);
+        if (p) { pbuf_take(p, &in[off + 2], (u16_t)len); if (nif.input(p, &nif) != ERR_OK) pbuf_free(p); }
+        off += 2 + len;
+      }
+      in.erase(in.begin(), in.begin() + off);
+    }
+    sys_check_timeouts();
+  }
+}
diff --git a/src/fptn-vless/test/failover_test.cpp b/src/fptn-vless/test/failover_test.cpp
new file mode 100644
index 0000000..e2fcd55
--- /dev/null
+++ b/src/fptn-vless/test/failover_test.cpp
@@ -0,0 +1,384 @@
+// Tests of the failover policy and controller with a fake "world": pings,
+// connect results and tunnel health are scripted, no network, no FPTN server.
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include "fptn-vless/failover.h"
+
+using namespace fptn::vless;
+using namespace std::chrono_literals;
+
+static int g_fail = 0;
+#define CHECK(cond, msg)                                         \
+  do {                                                           \
+    if (!(cond)) {                                               \
+      std::printf("  FAIL: %s\n", msg);                          \
+      ++g_fail;                                                  \
+    } else {                                                     \
+      std::printf("  ok:   %s\n", msg);                          \
+    }                                                            \
+  } while (0)
+
+static bool WaitFor(const std::function<bool()>& pred, int timeout_ms) {
+  const auto end = std::chrono::steady_clock::now() +
+                   std::chrono::milliseconds(timeout_ms);
+  while (std::chrono::steady_clock::now() < end) {
+    if (pred()) return true;
+    std::this_thread::sleep_for(5ms);
+  }
+  return pred();
+}
+
+static ServerHealth H(const char* name, PingMs ping, int failures = 0) {
+  ServerHealth h;
+  h.name = name;
+  h.last_ping = ping;
+  h.consecutive_failures = failures;
+  h.probed = true;
+  return h;
+}
+
+/* ------------------------------ fake world ------------------------------ */
+
+struct World {
+  std::mutex mu;
+  std::vector<PingMs> pings;
+  std::vector<bool> connectable;
+  std::vector<std::size_t> connect_log;
+  bool tunnel_down = false;
+  int miss_once = -1;  // this server misses exactly one probe
+  int probes = 0;
+
+  std::vector<std::size_t> Log() {
+    const std::lock_guard<std::mutex> l(mu);
+    return connect_log;
+  }
+  void Set(std::size_t i, PingMs p) {
+    const std::lock_guard<std::mutex> l(mu);
+    pings[i] = p;
+  }
+  void SetDown(bool v) {
+    const std::lock_guard<std::mutex> l(mu);
+    tunnel_down = v;
+  }
+};
+
+static FailoverController::Hooks MakeHooks(World& w) {
+  FailoverController::Hooks hooks;
+  hooks.probe_all = [&w]() {
+    const std::lock_guard<std::mutex> l(w.mu);
+    ++w.probes;
+    auto result = w.pings;
+    if (w.miss_once >= 0) {
+      result[static_cast<std::size_t>(w.miss_once)] = std::nullopt;
+      w.miss_once = -1;
+    }
+    return result;
+  };
+  hooks.connect = [&w](std::size_t i) {
+    const std::lock_guard<std::mutex> l(w.mu);
+    w.connect_log.push_back(i);
+    if (!w.connectable[i]) return false;
+    w.tunnel_down = false;  // a fresh tunnel is healthy
+    return true;
+  };
+  hooks.tunnel_down = [&w]() {
+    const std::lock_guard<std::mutex> l(w.mu);
+    return w.tunnel_down;
+  };
+  return hooks;
+}
+
+static FailoverController::Options FastOptions() {
+  FailoverController::Options o;
+  o.scan_interval = 120ms;
+  o.confirm_delay = 40ms;
+  o.down_grace = 100ms;
+  o.min_switch_gap = 30ms;
+  o.tick = 10ms;
+  return o;
+}
+
+static std::vector<std::string> Names(std::size_t n) {
+  std::vector<std::string> v;
+  for (std::size_t i = 0; i < n; ++i) v.push_back("S" + std::to_string(i));
+  return v;
+}
+
+int main() {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const SwitchPolicy p;  // defaults: ratio 1.5, margin 150 ms, 2 misses
+
+  std::puts("[1] Decide(): when to leave the active server");
+  {
+    auto d = Decide(p, {H("a", 100), H("b", 100)}, 0, false);
+    CHECK(!d.do_switch, "equal servers: stay");
+    d = Decide(p, {H("a", 100), H("b", 40)}, 0, false);
+    CHECK(!d.do_switch, "100 ms vs 40 ms (diff 60 < 150): stay");
+    d = Decide(p, {H("a", 200), H("b", 100)}, 0, false);
+    CHECK(!d.do_switch, "200 vs 100 (ratio 2 but diff 100 < 150): stay");
+    d = Decide(p, {H("a", 400), H("b", 280)}, 0, false);
+    CHECK(!d.do_switch, "400 vs 280 (diff 120, ratio 1.43): stay");
+    d = Decide(p, {H("a", 400), H("b", 100)}, 0, false);
+    CHECK(d.do_switch && d.target == 1, "400 vs 100: switch to the better one");
+    d = Decide(p, {H("a", std::nullopt, 1), H("b", 100)}, 0, false);
+    CHECK(!d.do_switch, "ONE missed probe is not a verdict: stay");
+    d = Decide(p, {H("a", std::nullopt, 2), H("b", 100)}, 0, false);
+    CHECK(d.do_switch && d.target == 1, "two missed probes: switch");
+    d = Decide(p, {H("a", 50), H("b", 60)}, 0, true);
+    CHECK(d.do_switch && d.target == 1, "tunnel down: switch even if probes ok");
+    d = Decide(p, {H("a", std::nullopt, 5), H("b", std::nullopt, 5)}, 0, false);
+    CHECK(!d.do_switch, "everything dead: nowhere to go, stay");
+    d = Decide(p, {H("a", std::nullopt, 2), H("b", 90), H("c", 30)}, 0, false);
+    CHECK(d.do_switch && d.target == 2, "dead server: pick the FASTEST other");
+    d = Decide(p, {H("a", 10), H("b", 20)}, std::nullopt, false);
+    CHECK(d.do_switch && d.target == 0, "no active server: pick the best");
+  }
+
+  std::puts("[2] ConnectOrder()");
+  {
+    auto order = ConnectOrder(
+        {H("a", 80), H("b", 40), H("c", std::nullopt), H("d", 60)}, std::nullopt);
+    CHECK((order == std::vector<std::size_t>{1, 3, 0, 2}),
+        "answering servers by ping, silent ones last");
+    order = ConnectOrder(
+        {H("a", 80), H("b", 40), H("c", std::nullopt)}, std::size_t{0});
+    CHECK((order == std::vector<std::size_t>{0, 1, 2}),
+        "preferred server goes first");
+    order = ConnectOrder({H("a", 80), H("b", 40), H("c", 50)}, std::nullopt, 1);
+    CHECK((order == std::vector<std::size_t>{2, 0}), "skip leaves one out");
+  }
+
+  std::puts("[3] controller: initial connection");
+  {
+    World w;
+    w.pings = {80, 40, std::nullopt};
+    w.connectable = {true, true, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    CHECK(c.Start() && c.Active() == 1, "connects to the fastest server");
+    CHECK((w.Log() == std::vector<std::size_t>{1}), "only one connect call");
+  }
+  {
+    World w;
+    w.pings = {80, 40, std::nullopt};
+    w.connectable = {true, true, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    CHECK(c.Start(std::size_t{0}) && c.Active() == 0, "user's choice wins");
+  }
+  {
+    World w;
+    w.pings = {80, 40, std::nullopt};
+    w.connectable = {true, false, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    CHECK(c.Start() && c.Active() == 0, "fastest not usable: next one");
+    CHECK((w.Log() == std::vector<std::size_t>{1, 0}), "tried 1 then 0");
+  }
+  {
+    World w;
+    w.pings = {80, 40};
+    w.connectable = {false, false};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    CHECK(!c.Start(), "no server usable: Start() reports failure");
+  }
+
+  std::puts("[4] controller: periodic scan failover");
+  {
+    World w;
+    w.pings = {80, 40, 90};
+    w.connectable = {true, true, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    c.Start();
+    w.Set(1, std::nullopt);  // the active server dies
+    CHECK(WaitFor([&] { return c.Active() == 0; }, 3000),
+        "dead active server -> moves to the best remaining one");
+    CHECK((w.Log() == std::vector<std::size_t>{1, 0}), "exactly one switch");
+  }
+  {
+    World w;
+    w.pings = {80, 40, 90};
+    w.connectable = {true, true, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    c.Start();
+    {
+      const std::lock_guard<std::mutex> l(w.mu);
+      w.miss_once = 1;  // one lost probe only
+    }
+    std::this_thread::sleep_for(900ms);
+    CHECK(c.Active() == 1 && w.Log().size() == 1,
+        "a single lost probe does not cause a switch");
+  }
+  {
+    World w;
+    w.pings = {400, 100};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});
+    CHECK(WaitFor([&] { return c.Active() == 1; }, 3000),
+        "high ping on the active server -> moves to the better one");
+  }
+  {
+    World w;
+    w.pings = {120, 100};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});
+    const int before = [&] { const std::lock_guard<std::mutex> l(w.mu); return w.probes; }();
+    std::this_thread::sleep_for(900ms);
+    const int after = [&] { const std::lock_guard<std::mutex> l(w.mu); return w.probes; }();
+    CHECK(after - before >= 4, "several scans really happened");
+    CHECK(w.Log().size() == 1, "small ping difference: no flapping");
+  }
+  {
+    World w;
+    w.pings = {80, 40};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});  // active = 0 (80 ms); then 1 gets slow too
+    w.Set(0, std::nullopt);
+    w.Set(1, std::nullopt);
+    std::this_thread::sleep_for(900ms);
+    CHECK(c.Active() == 0 && w.Log().size() == 1,
+        "everything dead: do not hop around, stay put");
+  }
+
+  std::puts("[5] controller: lost tunnel");
+  {
+    World w;
+    w.pings = {50, 60, 70};
+    w.connectable = {true, true, true};
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    c.Start();
+    CHECK(c.Active() == 0, "started on the best");
+    w.SetDown(true);  // the tunnel reports a lost connection
+    CHECK(WaitFor([&] { return c.Active() == 1; }, 3000),
+        "tunnel stays down past the grace period -> switch to next best");
+    CHECK((w.Log() == std::vector<std::size_t>{0, 1}), "one switch only");
+  }
+  {
+    World w;
+    w.pings = {50, 60};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start();
+    w.SetDown(true);
+    std::this_thread::sleep_for(40ms);
+    w.SetDown(false);  // it recovered by itself within the grace period
+    std::this_thread::sleep_for(600ms);
+    CHECK(c.Active() == 0 && w.Log().size() == 1,
+        "short outage that heals itself: no switch");
+  }
+  {
+    World w;
+    w.pings = {50, 60, 70};
+    w.connectable = {true, false, true};  // next best cannot be connected
+    FailoverController c(Names(3), FastOptions(), MakeHooks(w));
+    c.Start();
+    w.SetDown(true);
+    CHECK(WaitFor([&] { return c.Active() == 2; }, 3000),
+        "next best unusable -> tries the one after it");
+  }
+
+  std::puts("[6] controller: switches off / edge cases");
+  {
+    World w;
+    w.pings = {400, 40};
+    w.connectable = {true, true};
+    auto o = FastOptions();
+    o.failover = false;
+    FailoverController c(Names(2), o, MakeHooks(w));
+    c.Start(std::size_t{0});
+    w.SetDown(true);
+    std::this_thread::sleep_for(600ms);
+    CHECK(c.Active() == 0 && w.Log().size() == 1, "failover=false: never switches");
+  }
+  {
+    World w;
+    w.pings = {50};
+    w.connectable = {true};
+    FailoverController c(Names(1), FastOptions(), MakeHooks(w));
+    CHECK(c.Start() && c.Active() == 0, "single server works");
+    w.SetDown(true);
+    std::this_thread::sleep_for(300ms);
+    CHECK(w.Log().size() == 1, "single server: nothing to switch to");
+  }
+  {
+    World w;
+    w.pings = {50, 60};
+    w.connectable = {true, true};
+    auto o = FastOptions();
+    o.tick = 1000ms;  // long tick: Stop() must still be immediate
+    FailoverController c(Names(2), o, MakeHooks(w));
+    c.Start();
+    const auto t0 = std::chrono::steady_clock::now();
+    c.Stop();
+    const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now() - t0).count();
+    CHECK(ms < 500, "Stop() does not wait for the next tick");
+  }
+
+  std::puts("[7] pinned server, traffic check before leaving");
+  {
+    World w;  // user picked S0 (slow); S1 is much faster
+    w.pings = {600, 50};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});
+    c.SetPinned(true);
+    std::this_thread::sleep_for(700ms);
+    CHECK(c.Active() == 0, "pinned: stays on the slow server the user chose");
+    c.SetPinned(false);
+    CHECK(WaitFor([&] { return c.Active() == 1; }, 3000),
+        "unpinned: moves to the faster one");
+  }
+  {
+    World w;  // pinned server dies -> must still leave
+    w.pings = {600, 50};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});
+    c.SetPinned(true);
+    w.SetDown(true);
+    CHECK(WaitFor([&] { return c.Active() == 1; }, 3000),
+        "pinned but connection lost: still fails over");
+  }
+  {
+    World w;  // probes of S0 fail, but it carries traffic
+    w.pings = {std::nullopt, 50};
+    w.connectable = {true, true};
+    auto hooks = MakeHooks(w);
+    hooks.active_works = []() { return true; };
+    FailoverController c(Names(2), FastOptions(), hooks);
+    c.Start(std::size_t{0});
+    std::this_thread::sleep_for(700ms);
+    CHECK(c.Active() == 0, "probes missed but traffic works: no switch");
+  }
+  {
+    World w;  // probes fail AND no traffic -> leave
+    w.pings = {std::nullopt, 50};
+    w.connectable = {true, true};
+    auto hooks = MakeHooks(w);
+    hooks.active_works = []() { return false; };
+    FailoverController c(Names(2), FastOptions(), hooks);
+    c.Start(std::size_t{0});
+    CHECK(WaitFor([&] { return c.Active() == 1; }, 3000),
+        "probes missed and no traffic: switches");
+  }
+  {
+    World w;
+    w.pings = {400, 40};
+    w.connectable = {true, true};
+    FailoverController c(Names(2), FastOptions(), MakeHooks(w));
+    c.Start(std::size_t{0});
+    CHECK(c.SwitchTo(1, true) && c.Active() == 1 && c.Pinned(),
+        "SwitchTo(): manual switch pins the choice");
+    CHECK(!c.SwitchTo(9, true), "SwitchTo(): bad index is refused");
+  }
+
+  std::printf("\n%s\n", g_fail ? "FAILED" : "ALL PASSED");
+  return g_fail ? 1 : 0;
+}
diff --git a/src/fptn-vless/test/loopback_test.cpp b/src/fptn-vless/test/loopback_test.cpp
new file mode 100644
index 0000000..1b79db5
--- /dev/null
+++ b/src/fptn-vless/test/loopback_test.cpp
@@ -0,0 +1,280 @@
+// End-to-end test: VLESS client -> VlessServer -> UserspaceStack(lwIP) -> framed
+// IP packets over pipes -> echo_peer (second lwIP) and back. No fptn deps.
+#include <signal.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <iostream>
+#include <thread>
+#include <vector>
+
+#include <boost/asio.hpp>
+
+#include "fptn-vless/tunnel_check.h"
+#include "fptn-vless/userspace_stack.h"
+#include "fptn-vless/vless_server.h"
+
+using namespace fptn::vless;
+namespace asio = boost::asio;
+using asio::ip::tcp;
+
+static int g_fail = 0;
+#define CHECK(cond, msg)                                              \
+  do {                                                                \
+    if (!(cond)) { std::printf("  FAIL: %s\n", msg); ++g_fail; }       \
+    else { std::printf("  ok:   %s\n", msg); }                         \
+  } while (0)
+
+static bool ReadFull(int fd, void* d, size_t n) {
+  char* p = static_cast<char*>(d);
+  while (n) { ssize_t r = read(fd, p, n); if (r <= 0) return false; p += r; n -= (size_t)r; }
+  return true;
+}
+
+static Uuid g_uuid;
+static uint16_t g_port = 18800;
+
+static std::vector<uint8_t> Header(const Uuid& u, uint8_t atype, const std::vector<uint8_t>& addr, uint16_t port) {
+  std::vector<uint8_t> h{0};
+  h.insert(h.end(), u.begin(), u.end());
+  h.push_back(0);        // addons len
+  h.push_back(1);        // cmd TCP
+  h.push_back((uint8_t)(port >> 8)); h.push_back((uint8_t)port);
+  h.push_back(atype);
+  h.insert(h.end(), addr.begin(), addr.end());
+  return h;
+}
+
+static tcp::socket Dial(asio::io_context& ioc) {
+  tcp::socket s(ioc);
+  s.connect({asio::ip::make_address("127.0.0.1"), g_port});
+  return s;
+}
+static std::vector<uint8_t> To10_0_0_2() { return {10, 0, 0, 2}; }
+
+int main() {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  signal(SIGPIPE, SIG_IGN);
+  g_uuid = GenerateUuid();
+
+  int to_peer[2], from_peer[2];
+  if (pipe(to_peer) || pipe(from_peer)) return 2;
+  pid_t pid = fork();
+  if (pid == 0) {
+    dup2(to_peer[0], 0); dup2(from_peer[1], 1);
+    close(to_peer[1]); close(from_peer[0]);
+    execl("./echo_peer", "echo_peer", (char*)nullptr);
+    _exit(127);
+  }
+  close(to_peer[0]); close(from_peer[1]);
+
+  auto& stack = UserspaceStack::Instance();
+  UserspaceStack::Config sc; sc.ipv4 = "10.0.0.1"; sc.mtu = 1420;
+  if (!stack.Start(sc)) { std::puts("stack start failed"); return 2; }
+
+  std::atomic<bool> run{true};
+  std::thread tx([&] {  // stack -> peer
+    std::vector<uint8_t> buf(65536);
+    while (run) {
+      int n = stack.TakeOutput(buf.data(), buf.size(), 5);
+      if (n <= 0) continue;
+      uint8_t hdr[2] = {(uint8_t)(n >> 8), (uint8_t)n};
+      if (write(to_peer[1], hdr, 2) != 2 || write(to_peer[1], buf.data(), (size_t)n) != n) break;
+    }
+  });
+  std::thread rx([&] {  // peer -> stack
+    std::vector<uint8_t> buf(65536);
+    for (;;) {
+      uint8_t hdr[2];
+      if (!ReadFull(from_peer[0], hdr, 2)) break;
+      size_t n = ((size_t)hdr[0] << 8) | hdr[1];
+      if (!ReadFull(from_peer[0], buf.data(), n)) break;
+      stack.Input(buf.data(), n);
+    }
+  });
+
+  asio::io_context ioc;
+  VlessServer::Config vc; vc.listen_address = "127.0.0.1"; vc.port = g_port; vc.uuid = g_uuid;
+  vc.connect_timeout_sec = 3; vc.linger_after_remote_close_sec = 2;
+  VlessServer server(ioc, vc, stack);
+  if (!server.Start()) { std::puts("server start failed"); return 2; }
+  auto guard = asio::make_work_guard(ioc);
+  std::thread io([&] { ioc.run(); });
+
+  asio::io_context cio;
+  boost::system::error_code ec;
+
+  std::puts("[1] echo through the tunnel");
+  {
+    auto s = Dial(cio);
+    auto h = Header(g_uuid, 1, To10_0_0_2(), 7);
+    h.insert(h.end(), {'h', 'e', 'l', 'l', 'o'});
+    asio::write(s, asio::buffer(h));
+    uint8_t resp[7]; asio::read(s, asio::buffer(resp), ec);
+    CHECK(!ec && resp[0] == 0 && resp[1] == 0, "VLESS response header 00 00");
+    CHECK(!ec && std::memcmp(resp + 2, "hello", 5) == 0, "payload echoed back");
+  }
+
+  std::puts("[2] download 4 MiB (lwIP -> socket, backpressure)");
+  {
+    auto t0 = std::chrono::steady_clock::now();
+    auto s = Dial(cio);
+    asio::write(s, asio::buffer(Header(g_uuid, 1, To10_0_0_2(), 9)));
+    uint8_t resp[2]; asio::read(s, asio::buffer(resp));
+    size_t total = 0; bool pattern_ok = true; uint8_t buf[65536];
+    for (;;) {
+      size_t n = s.read_some(asio::buffer(buf), ec);
+      for (size_t i = 0; i < n; ++i) if (buf[i] != (uint8_t)((total + i) % 251)) pattern_ok = false;
+      total += n;
+      if (ec) break;
+    }
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(total == 4u * 1024 * 1024, "received exactly 4 MiB");
+    CHECK(pattern_ok, "byte pattern intact");
+    std::printf("        %.2f s, %.1f MiB/s\n", sec, 4.0 / sec);
+  }
+
+  std::puts("[3] upload 4 MiB (socket -> lwIP) + half-close");
+  {
+    auto t0 = std::chrono::steady_clock::now();
+    auto s = Dial(cio);
+    auto h = Header(g_uuid, 1, To10_0_0_2(), 19);
+    asio::write(s, asio::buffer(h));
+    std::vector<uint8_t> chunk(32768); uint32_t sum = 0; size_t sent = 0;
+    const size_t N = 4u * 1024 * 1024;
+    while (sent < N) {
+      for (size_t i = 0; i < chunk.size(); ++i) { chunk[i] = (uint8_t)((sent + i) % 251); sum += chunk[i]; }
+      asio::write(s, asio::buffer(chunk));
+      sent += chunk.size();
+    }
+    s.shutdown(tcp::socket::shutdown_send);
+    uint8_t resp[2 + 8]; asio::read(s, asio::buffer(resp), ec);
+    uint32_t cnt = (uint32_t)resp[2] << 24 | resp[3] << 16 | resp[4] << 8 | resp[5];
+    uint32_t sm = (uint32_t)resp[6] << 24 | resp[7] << 16 | resp[8] << 8 | resp[9];
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(!ec, "peer answered after FIN");
+    CHECK(cnt == N, "peer counted 4 MiB");
+    CHECK(sm == sum, "peer checksum matches");
+    std::printf("        %.2f s, %.1f MiB/s\n", sec, 4.0 / sec);
+  }
+
+  std::puts("[4] 8 parallel downloads");
+  {
+    std::atomic<int> good{0};
+    std::vector<std::thread> th;
+    auto t0 = std::chrono::steady_clock::now();
+    for (int i = 0; i < 8; ++i) th.emplace_back([&] {
+      asio::io_context c2; tcp::socket s(c2); boost::system::error_code e;
+      s.connect({asio::ip::make_address("127.0.0.1"), g_port});
+      asio::write(s, asio::buffer(Header(g_uuid, 1, To10_0_0_2(), 9)));
+      size_t total = 0; uint8_t buf[65536];
+      for (;;) { size_t n = s.read_some(asio::buffer(buf), e); total += n; if (e) break; }
+      if (total == 2 + 4u * 1024 * 1024) ++good;
+    });
+    for (auto& t : th) t.join();
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(good == 8, "all 8 downloads complete with the right size");
+    std::printf("        %.2f s total (%.1f MiB/s aggregate)\n", sec, 32.0 / sec);
+  }
+
+  std::puts("[5] error handling");
+  {
+    Uuid bad = g_uuid; bad[0] ^= 0xFF;
+    auto s = Dial(cio);
+    asio::write(s, asio::buffer(Header(bad, 1, To10_0_0_2(), 7)));
+    uint8_t b[1]; s.read_some(asio::buffer(b), ec);
+    CHECK(ec == asio::error::eof || ec == asio::error::connection_reset, "wrong UUID -> connection closed");
+  }
+  {
+    auto t0 = std::chrono::steady_clock::now();
+    auto s = Dial(cio);
+    asio::write(s, asio::buffer(Header(g_uuid, 1, {10, 0, 0, 99}, 80)));
+    uint8_t b[1]; s.read_some(asio::buffer(b), ec);
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(ec && sec > 2.0 && sec < 6.0, "unreachable target -> closed by connect timeout (~3 s)");
+  }
+  {
+    auto s = Dial(cio);
+    auto h = Header(g_uuid, 1, To10_0_0_2(), 4444);  // closed port -> RST
+    asio::write(s, asio::buffer(h));
+    uint8_t b[1]; s.read_some(asio::buffer(b), ec);
+    CHECK(ec, "closed remote port -> connection closed");
+  }
+
+  std::puts("[6] tunnel replaced by one to another server (failover)");
+  {
+    auto s = Dial(cio);
+    auto h = Header(g_uuid, 1, To10_0_0_2(), 7);
+    h.insert(h.end(), {'a', 'b'});
+    asio::write(s, asio::buffer(h));
+    uint8_t resp[4];
+    asio::read(s, asio::buffer(resp), ec);
+    CHECK(!ec && std::memcmp(resp + 2, "ab", 2) == 0, "established connection works");
+    auto t0 = std::chrono::steady_clock::now();
+    stack.ResetForNewTunnel("");  // what the failover does when it switches servers
+    uint8_t b[1];
+    s.read_some(asio::buffer(b), ec);
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(ec && sec < 1.0, "open connection is dropped at once (client can reconnect)");
+  }
+  {
+    auto s = Dial(cio);  // target that never answers: would wait for the 3 s timeout
+    asio::write(s, asio::buffer(Header(g_uuid, 1, {10, 0, 0, 99}, 80)));
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    auto t0 = std::chrono::steady_clock::now();
+    stack.ResetForNewTunnel("");
+    uint8_t b[1];
+    s.read_some(asio::buffer(b), ec);
+    double sec = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    CHECK(ec && sec < 1.0, "half-open connection is dropped at once, not after the timeout");
+  }
+  {
+    auto s = Dial(cio);
+    auto h = Header(g_uuid, 1, To10_0_0_2(), 7);
+    h.insert(h.end(), {'o', 'k'});
+    asio::write(s, asio::buffer(h));
+    uint8_t resp[4];
+    asio::read(s, asio::buffer(resp), ec);
+    CHECK(!ec && std::memcmp(resp + 2, "ok", 2) == 0, "new connections work after the reset");
+  }
+
+  std::puts("[7] tunnel check explains what is broken");
+  {
+    // The peer only owns 10.0.0.2, so 1.1.1.1 is "not answered by the server".
+    auto r = CheckTunnel(stack, 2);
+    CHECK(!r.by_ip_ms && !r.by_name_ms, "no answer from the server: both probes fail");
+    CHECK(r.packets_out > 0, "packets were handed to the tunnel");
+    TunnelCheckResult silent;  // nothing came back
+    silent.packets_out = 5;
+    CHECK(silent.Summary().find("does not answer") != std::string::npos,
+        "summary: no packets back -> server does not answer");
+    TunnelCheckResult no_dns;
+    no_dns.by_ip_ms = 120;
+    no_dns.packets_out = 9;
+    no_dns.packets_in = 4;
+    CHECK(no_dns.Summary().find("DNS") != std::string::npos,
+        "summary: IP works, names do not -> DNS");
+    TunnelCheckResult dead;
+    CHECK(dead.Summary().find("Nothing left") != std::string::npos,
+        "summary: no packets out -> stack/tunnel not working");
+    TunnelCheckResult good;
+    good.by_ip_ms = 100;
+    good.by_name_ms = 200;
+    CHECK(good.Ok() && good.Summary().find("FAILED") == std::string::npos,
+        "summary: all good");
+    CHECK(!TunnelCarriesTraffic(stack, 2), "TunnelCarriesTraffic() is false");
+  }
+
+  std::printf("\n%s  (stack drops in/out: %llu/%llu)\n", g_fail ? "FAILED" : "ALL PASSED",
+      (unsigned long long)stack.DroppedIn(), (unsigned long long)stack.DroppedOut());
+
+  run = false; server.Stop(); guard.reset(); ioc.stop();
+  kill(pid, SIGTERM); waitpid(pid, nullptr, 0);
+  close(to_peer[1]); tx.join(); io.join(); rx.join();
+  stack.Stop();
+  return g_fail ? 1 : 0;
+}
diff --git a/src/fptn-vless/tunnel_check.cpp b/src/fptn-vless/tunnel_check.cpp
new file mode 100644
index 0000000..d9b1a33
--- /dev/null
+++ b/src/fptn-vless/tunnel_check.cpp
@@ -0,0 +1,100 @@
+#include "fptn-vless/tunnel_check.h"
+
+#include <atomic>
+#include <chrono>
+#include <future>
+#include <memory>
+
+#include <fmt/format.h>  // NOLINT(build/include_order)
+
+namespace fptn::vless {
+
+namespace {
+
+std::optional<int> TryConnect(
+    UserspaceStack& stack, Target target, int timeout_sec) {
+  auto done = std::make_shared<std::promise<bool>>();
+  auto answer = done->get_future();
+  auto once = std::make_shared<std::atomic<bool>>(false);
+  FlowCallbacks callbacks;
+  callbacks.on_connected = [done, once](bool ok) {
+    if (!once->exchange(true)) {
+      done->set_value(ok);
+    }
+  };
+  callbacks.on_error = [done, once]() {
+    if (!once->exchange(true)) {
+      done->set_value(false);
+    }
+  };
+  const auto started = std::chrono::steady_clock::now();
+  const TcpFlowPtr flow = stack.Connect(std::move(target), std::move(callbacks));
+  std::optional<int> result;
+  if (answer.wait_for(std::chrono::seconds(timeout_sec)) ==
+          std::future_status::ready &&
+      answer.get()) {
+    result = static_cast<int>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now() - started)
+            .count());
+  }
+  flow->Close(true);  // RST: nothing was sent, nobody to be polite to
+  return result;
+}
+
+}  // namespace
+
+TunnelCheckResult CheckTunnel(UserspaceStack& stack, int timeout_sec) {
+  TunnelCheckResult result;
+  const std::uint64_t out0 = stack.PacketsOut();
+  const std::uint64_t in0 = stack.PacketsIn();
+  Target by_ip;
+  by_ip.is_ipv4 = true;
+  by_ip.ipv4_be = 0x01010101;  // 1.1.1.1 (same in either byte order)
+  by_ip.port = 443;
+  result.by_ip_ms = TryConnect(stack, by_ip, timeout_sec);
+  Target by_name;
+  by_name.host = "example.com";
+  by_name.port = 443;
+  result.by_name_ms = TryConnect(stack, by_name, timeout_sec);
+  result.packets_out = stack.PacketsOut() - out0;
+  result.packets_in = stack.PacketsIn() - in0;
+  return result;
+}
+
+bool TunnelCarriesTraffic(UserspaceStack& stack, int timeout_sec) {
+  for (const std::uint32_t ip : {0x01010101u, 0x08080808u}) {  // 1.1.1.1, 8.8.8.8
+    Target by_ip;
+    by_ip.is_ipv4 = true;
+    by_ip.ipv4_be = ip;
+    by_ip.port = 443;
+    if (TryConnect(stack, by_ip, timeout_sec / 2).has_value()) {
+      return true;
+    }
+  }
+  return false;
+}
+
+std::string TunnelCheckResult::Summary() const {
+  const auto part = [](const std::optional<int>& ms) {
+    return ms ? fmt::format("ok, {} ms", *ms) : std::string("FAILED");
+  };
+  std::string text = fmt::format("Tunnel check: by IP {}; by name {}",
+      part(by_ip_ms), part(by_name_ms));
+  if (Ok()) {
+    return text;
+  }
+  text += fmt::format(" (packets to the server: {}, from the server: {})",
+      packets_out, packets_in);
+  if (!by_ip_ms && packets_out == 0) {
+    text += ". Nothing left the program: the stack/tunnel is not working.";
+  } else if (!by_ip_ms && packets_in == 0) {
+    text += ". The server receives nothing back: it does not answer or "
+            "filters this traffic.";
+  } else if (by_ip_ms && !by_name_ms) {
+    text += ". Internet works but names do not resolve (DNS).";
+  }
+  return text;
+}
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/tunnel_check.h b/src/fptn-vless/tunnel_check.h
new file mode 100644
index 0000000..21bc278
--- /dev/null
+++ b/src/fptn-vless/tunnel_check.h
@@ -0,0 +1,32 @@
+#pragma once
+
+/*
+ * "Does the tunnel actually carry traffic?" Two probes through the userspace
+ * stack: a TCP connection to a public IP (routing/NAT) and one to a host name
+ * (DNS). The result tells which part is broken when sites do not open.
+ */
+
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include "fptn-vless/userspace_stack.h"
+
+namespace fptn::vless {
+
+struct TunnelCheckResult {
+  std::optional<int> by_ip_ms;    // TCP connect to 1.1.1.1:443
+  std::optional<int> by_name_ms;  // DNS + TCP connect to example.com:443
+  std::uint64_t packets_out = 0;  // IP packets given to the tunnel
+  std::uint64_t packets_in = 0;   // IP packets received from it
+
+  [[nodiscard]] bool Ok() const { return by_ip_ms && by_name_ms; }
+  [[nodiscard]] std::string Summary() const;
+};
+
+TunnelCheckResult CheckTunnel(UserspaceStack& stack, int timeout_sec = 8);
+
+// Quick yes/no: can a TCP connection to a public IP be opened through it?
+bool TunnelCarriesTraffic(UserspaceStack& stack, int timeout_sec = 6);
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/tunnel_manager.cpp b/src/fptn-vless/tunnel_manager.cpp
new file mode 100644
index 0000000..b804c8a
--- /dev/null
+++ b/src/fptn-vless/tunnel_manager.cpp
@@ -0,0 +1,183 @@
+#include "fptn-vless/tunnel_manager.h"
+
+#include <algorithm>
+#include <condition_variable>
+#include <cstdint>
+#include <memory>
+#include <thread>
+#include <utility>
+
+#include <spdlog/spdlog.h>  // NOLINT(build/include_order)
+
+#include "common/network/ip_address.h"
+#include "fptn-vless/events.h"
+#include "common/network/net_interface.h"
+#include "fptn-client/utils/speed_estimator/speed_estimator.h"
+#include "fptn-protocol-lib/https/connection_config.h"
+#include "fptn-vless/userspace_stack.h"
+#include "routing/route_manager.h"  // ResolveDomain only
+#include "vpn/http/client.h"
+
+namespace fptn::vless {
+
+using fptn::utils::speed_estimator::ServerInfo;
+
+TunnelManager::TunnelManager(
+    const fptn::config::ConfigFile& config, Options options)
+    : servers_(config.GetServers()),
+      default_username_(config.GetUsername()),
+      default_password_(config.GetPassword()),
+      options_(std::move(options)) {}
+
+TunnelManager::~TunnelManager() { Shutdown(); }
+
+std::vector<PingMs> TunnelManager::ProbeAll() {
+  struct State {
+    std::mutex mu;
+    std::condition_variable cv;
+    std::vector<PingMs> results;
+    std::size_t done = 0;
+  };
+  auto state = std::make_shared<State>();
+  state->results.resize(servers_.size());
+
+  for (std::size_t i = 0; i < servers_.size(); ++i) {
+    // Detached on purpose (like FPTN's own speed estimator): a probe that
+    // hangs must not hold up the others, its late answer is simply ignored.
+    // NOLINTNEXTLINE(bugprone-exception-escape)
+    std::thread([state, i, server = servers_[i], sni = options_.sni,
+                    timeout = options_.probe_timeout_sec,
+                    strategy = options_.censorship_strategy]() {
+      PingMs ping;
+      try {
+        const std::uint64_t ms = fptn::utils::speed_estimator::GetDownloadTimeMs(
+            server, sni, timeout, server.md5_fingerprint, strategy);
+        if (ms != UINT64_MAX) {  // GetDownloadTimeMs' "no answer" marker
+          ping = static_cast<std::uint32_t>(
+              std::min<std::uint64_t>(ms, UINT32_MAX));
+        }
+      } catch (...) {  // NOLINT
+      }
+      {
+        const std::lock_guard<std::mutex> lock(state->mu);
+        state->results[i] = ping;
+        ++state->done;
+      }
+      state->cv.notify_all();
+    }).detach();
+  }
+
+  std::unique_lock<std::mutex> lock(state->mu);
+  state->cv.wait_for(
+      lock, std::chrono::seconds(options_.probe_timeout_sec + 2),
+      [&state, this]() { return state->done == servers_.size(); });
+  return state->results;
+}
+
+bool TunnelManager::Connect(std::size_t index) {
+  if (index >= servers_.size()) {
+    return false;
+  }
+  const ServerInfo& server = servers_[index];
+  try {
+    const auto server_ip = fptn::routing::ResolveDomain(server.host);
+    if (server_ip.IsEmpty()) {
+      SPDLOG_WARN("DNS resolve error: {}", server.host);
+      return false;
+    }
+    const auto tun_ipv4 = fptn::common::network::IPv4Address::Create(
+        FPTN_CLIENT_DEFAULT_ADDRESS_IP4);
+    const auto tun_ipv6 = fptn::common::network::IPv6Address::Create(
+        FPTN_CLIENT_DEFAULT_ADDRESS_IP6);
+
+    // 1. Log in to the NEW server while the old tunnel keeps working.
+    auto http_client = std::make_unique<fptn::vpn::http::Client>(
+        fptn::protocol::https::ConnectionConfig{
+            .common ={
+                    .server_ip = server_ip,
+                    .server_port = static_cast<std::uint16_t>(server.port),
+                    .sni = options_.sni,
+                    .md5_fingerprint = server.md5_fingerprint,
+                    .client_version = FPTN_VERSION,
+                    .censorship_strategy = options_.censorship_strategy,
+                    .tun_interface_address_ipv4 = tun_ipv4,
+                    .tun_interface_address_ipv6 = tun_ipv6,
+                }},
+        options_.connection_strategy);
+    const std::string& username =
+        server.username.empty() ? default_username_ : server.username;
+    const std::string& password =
+        server.password.empty() ? default_password_ : server.password;
+    if (!http_client->Login(username, password)) {
+      Notify("Login to '{}' failed (code {}): {}", server.name,
+          http_client->LatestErrorCode(), http_client->LatestError());
+      return false;
+    }
+    const auto [dns_ipv4, dns_ipv6] = http_client->GetDns();
+    if (dns_ipv4.IsEmpty()) {
+      SPDLOG_WARN("Server '{}' did not provide a DNS address", server.name);
+      return false;
+    }
+
+    // 2. The new one is ready: replace the old tunnel. Two tunnels must never
+    // run at once, they would fight over the packets of the userspace stack.
+    const std::lock_guard<std::mutex> lock(mu_);
+    if (vpn_) {
+      vpn_->Stop();
+      vpn_.reset();
+    }
+    // The old server knows nothing about our open connections.
+    UserspaceStack::Instance().ResetForNewTunnel(dns_ipv4.ToString());
+
+    auto virtual_network_interface =
+        std::make_shared<fptn::common::network::TunInterface>(
+            fptn::common::network::TunInterface::Config{
+                .name = "fptn-userspace",
+                .mtu_size = options_.mtu_size,
+                .using_rate_calculator = false,
+                .ipv4_addr = tun_ipv4,
+                .ipv4_netmask = 32,
+                .ipv6_addr = tun_ipv6,
+                .ipv6_netmask = 126});
+    // No route manager, no plugins: nothing is changed on this machine.
+    auto vpn = std::make_unique<fptn::vpn::VpnManager>(
+        fptn::vpn::VpnManager::Config{.http_client = std::move(http_client),
+            .route_manager = nullptr,
+            .virtual_net_interface = virtual_network_interface,
+            .plugins = {}});
+    if (!vpn->Start()) {
+      Notify("Cannot start the FPTN connection to '{}'", server.name);
+      return false;  // IsDown() is now true; the controller will move on
+    }
+    vpn_ = std::move(vpn);
+    return true;
+  } catch (const std::exception& ex) {
+    Notify("Connecting to '{}' failed: {}", server.name, ex.what());
+  } catch (...) {
+    SPDLOG_WARN("Connecting to '{}' failed", server.name);
+  }
+  return false;
+}
+
+std::vector<std::string> TunnelManager::Names() const {
+  std::vector<std::string> names;
+  for (const auto& server : servers_) {
+    names.push_back(server.name);
+  }
+  return names;
+}
+
+bool TunnelManager::IsDown() const {
+  const std::lock_guard<std::mutex> lock(mu_);
+  return !vpn_ || vpn_->IsReconnecting() || !vpn_->IsStarted();
+}
+
+void TunnelManager::Shutdown() {
+  const std::lock_guard<std::mutex> lock(mu_);
+  if (vpn_) {
+    vpn_->Stop();
+    vpn_.reset();
+  }
+}
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/tunnel_manager.h b/src/fptn-vless/tunnel_manager.h
new file mode 100644
index 0000000..d8aaf2f
--- /dev/null
+++ b/src/fptn-vless/tunnel_manager.h
@@ -0,0 +1,73 @@
+#pragma once
+
+/*
+ * The FPTN-specific half of multi-server support: probes servers, logs in,
+ * and swaps the live tunnel. The policy that decides WHEN to do that lives in
+ * failover.h and knows nothing about FPTN.
+ */
+
+#include <cstddef>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+#include "config/config_file.h"
+#include "fptn-protocol-lib/connection/strategies/base_strategy_connection.h"
+#include "fptn-protocol-lib/https/censorship_strategy.h"
+#include "fptn-vless/failover.h"
+#include "fptn-vless/tunnels.h"
+#include "vpn/vpn_manager.h"
+
+namespace fptn::vless {
+
+class TunnelManager final : public ITunnels {
+ public:
+  struct Options {
+    std::string sni;
+    fptn::protocol::https::CensorshipStrategy censorship_strategy;
+    fptn::protocol::connection::strategies::ConnectionStrategy
+        connection_strategy;
+    int mtu_size = 1420;
+    int probe_timeout_sec = 8;
+  };
+
+  TunnelManager(const fptn::config::ConfigFile& config, Options options);
+  ~TunnelManager() override;
+  TunnelManager(const TunnelManager&) = delete;
+  TunnelManager& operator=(const TunnelManager&) = delete;
+
+  [[nodiscard]] const std::vector<fptn::utils::speed_estimator::ServerInfo>&
+  Servers() const noexcept {
+    return servers_;
+  }
+
+  // Response time of every server (all at once). Uses the same unauthenticated
+  // 100 KB test download FPTN uses to rank servers, through the configured
+  // bypass method, so a blocked server shows up as "no response". It does not
+  // log in, so it cannot disturb the current session.
+  std::vector<PingMs> ProbeAll() override;
+
+  // Makes server `index` the active one. The new connection is logged in
+  // first; only then the old tunnel is replaced. False = the old tunnel is
+  // left untouched.
+  bool Connect(std::size_t index) override;
+
+  // The live tunnel lost its connection (or there is none).
+  [[nodiscard]] bool IsDown() const override;
+
+  void Shutdown() override;
+
+  std::vector<std::string> Names() const override;
+
+ private:
+  const std::vector<fptn::utils::speed_estimator::ServerInfo> servers_;
+  const std::string default_username_;
+  const std::string default_password_;
+  const Options options_;
+
+  mutable std::mutex mu_;
+  std::unique_ptr<fptn::vpn::VpnManager> vpn_;
+};
+
+}  // namespace fptn::vless

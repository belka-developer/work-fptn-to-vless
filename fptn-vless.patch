+tr.act td{font-weight:600}.mut{color:var(--mut)}
+pre{margin:0;max-height:240px;overflow:auto;font:12.5px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap}
+</style></head><body><main>
+<h1>fptn-vless</h1>
+<div class="row mut"><span id="dot" class="dot"></span><span id="status">...</span></div>
+
+<div id="c_token" class="card" hidden><h2>Токен доступа FPTN</h2>
+<textarea id="token" rows="4" placeholder="Вставьте токен целиком (fptnb:…). Пробелы и переносы строк не страшны." spellcheck="false"></textarea>
+<div class="row" style="margin-top:8px"><label class="grow"><input type="checkbox" id="remember" checked> Запомнить на этом компьютере (хранится зашифрованным для вашей учётной записи Windows)</label>
+<button id="send" class="p">Загрузить серверы</button></div>
+<div id="token_msg" class="err" style="margin-top:8px"></div></div>
+
+<div id="c_link" class="card" hidden><h2>Ссылка для телефона / другого ПК</h2>
+<div class="row"><select id="host"></select><button id="copy" class="p">Копировать</button></div>
+<div style="margin-top:8px"><input id="link" class="link" readonly></div>
+<div class="mut" style="margin-top:6px">Телефон и ПК должны быть в одной Wi-Fi сети. Если ссылка не импортируется, введите вручную: VLESS, адрес и порт из ссылки, UUID <span id="uuid"></span>, tcp, security none, encryption none.</div></div>
+
+<div id="c_servers" class="card" hidden><div class="row"><h2 class="grow" style="margin:0">Серверы</h2>
+<button id="fast" class="p" hidden>Подключиться к самому быстрому</button>
+<button id="disconnect" hidden>Отключиться</button>
+<button id="rescan">Замерить заново</button><button id="check" hidden>Проверить туннель</button></div>
+<div class="row" style="margin:6px 0"><span id="busy" class="mut grow"></span><button id="unpin" hidden>Выбирать сервер автоматически</button></div>
+<div id="msg" class="err"></div>
+<table><thead><tr><th>Сервер</th><th class="n">Отклик</th><th></th></tr></thead><tbody id="servers"></tbody></table>
+<div id="check_result" class="mut" style="margin-top:8px"></div>
+<div style="margin-top:10px"><button id="forget">Сменить токен</button></div></div>
+
+<div class="card"><h2>События</h2><pre id="events"></pre></div>
+</main>
+<script>
+const $=id=>document.getElementById(id);
+let state=null;
+async function post(path,body){
+  try{await fetch(path,{method:'POST',headers:{'X-Requested-With':'fptn'},body:body||''});}catch(e){}
+  refresh();
+}
+function ping(s){return !s.probed?'...':(s.ping===null?'нет ответа':s.ping+' мс');}
+function render(){
+  const s=state; if(!s) return;
+  const connected=s.phase==='connected', has=s.servers.length>0;
+  const working=!!s.busy||s.phase==='scanning'||s.phase==='connecting';
+  $('dot').className='dot '+(s.tunnel_down?'bad':(connected?'ok':''));
+  let st='Не подключено';
+  if(s.phase==='no_token') st='Нужен токен';
+  else if(working) st=s.busy||s.message||'Работаю...';
+  else if(connected){
+    st=(s.tunnel_down?'Связь с сервером потеряна: ':'Подключено: ')+(s.servers[s.active_index]?s.servers[s.active_index].name:'')
+      +(s.pinned?' · выбран вручную (сменится сам только при обрыве)':(s.failover?' · автопереключение включено':''));
+  } else if(s.phase==='ready') st='Выберите сервер';
+  $('status').textContent=st;
+
+  $('c_token').hidden = s.phase!=='no_token';
+  $('token_msg').textContent = s.phase==='no_token' ? (s.message||'') : '';
+  $('send').disabled = working;
+  $('c_link').hidden = !connected;
+  $('c_servers').hidden = !has;
+  $('fast').hidden = connected; $('disconnect').hidden = !connected; $('check').hidden = !connected;
+  $('fast').disabled = working; $('disconnect').disabled = working; $('rescan').disabled = working; $('check').disabled = working;
+  $('forget').disabled = working;
+  $('busy').textContent = s.busy||''; $('unpin').hidden = !s.pinned;
+  $('msg').textContent = s.phase==='ready' ? (s.message||'') : '';
+
+  const sel=$('host');
+  if(sel.options.length!==s.links.length){
+    sel.innerHTML=''; s.links.forEach((l,i)=>{const o=document.createElement('option');o.value=i;o.textContent=l.host;sel.appendChild(o);});
+  }
+  const li=Math.min(+sel.value||0,s.links.length-1);
+  $('link').value=s.links[li]?s.links[li].url:''; $('uuid').textContent=s.uuid;
+
+  const tb=$('servers'); tb.innerHTML='';
+  s.servers.forEach((sv,i)=>{
+    const tr=document.createElement('tr'); if(connected&&i===s.active_index) tr.className='act';
+    tr.innerHTML='<td></td><td class="n"></td><td class="n"></td>';
+    tr.children[0].textContent=sv.name+(connected&&i===s.active_index?'  ✓':'');
+    tr.children[1].textContent=ping(sv);
+    if(!(connected&&i===s.active_index)){const b=document.createElement('button');b.textContent='Подключиться';b.disabled=working;b.onclick=()=>post('/api/connect?i='+i);tr.children[2].appendChild(b);}
+    tb.appendChild(tr);
+  });
+  $('check_result').textContent=s.check||'';
+  const ev=$('events'), atBottom=ev.scrollTop+ev.clientHeight>=ev.scrollHeight-20;
+  ev.textContent=s.events.join('\n'); if(atBottom) ev.scrollTop=ev.scrollHeight;
+}
+async function refresh(){
+  try{const r=await fetch('/api/state');state=await r.json();render();}
+  catch(e){$('status').textContent='Программа не отвечает (закрыта?)';$('dot').className='dot bad';}
+}
+$('host').onchange=render;
+$('send').onclick=()=>{const t=$('token').value; if(!t.trim()) return; post('/api/token?remember='+($('remember').checked?1:0),t); $('token').value='';};
+$('fast').onclick=()=>post('/api/connect?auto=1');
+$('disconnect').onclick=()=>post('/api/disconnect');
+$('forget').onclick=()=>{if(confirm('Отключиться и удалить сохранённый токен?')) post('/api/forget');};
+$('copy').onclick=async()=>{const t=$('link').value;try{await navigator.clipboard.writeText(t);}catch(e){$('link').select();document.execCommand('copy');}$('copy').textContent='Скопировано';setTimeout(()=>$('copy').textContent='Копировать',1200);};
+$('unpin').onclick=()=>post('/api/unpin'); $('rescan').onclick=()=>post('/api/rescan'); $('check').onclick=()=>post('/api/check');
+refresh(); setInterval(refresh,1500);
+</script></body></html>
+)HTML";
+
+std::string Response(int code,
+    const char* reason,
+    const char* type,
+    const std::string& body) {
+  std::ostringstream out;
+  out << "HTTP/1.1 " << code << ' ' << reason << "\r\n"
+      << "Content-Type: " << type << "\r\n"
+      << "Content-Length: " << body.size() << "\r\n"
+      << "Cache-Control: no-store\r\n"
+      << "X-Content-Type-Options: nosniff\r\n"
+      << "Connection: close\r\n\r\n"
+      << body;
+  return out.str();
+}
+
+std::string Lower(std::string s) {
+  std::transform(s.begin(), s.end(), s.begin(),
+      [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return s;
+}
+
+// Value of a header (case-insensitive name), "" if absent.
+std::string Header(const std::string& head, const std::string& name) {
+  std::istringstream in(head);
+  std::string line;
+  std::getline(in, line);  // request line
+  while (std::getline(in, line)) {
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    const auto colon = line.find(':');
+    if (colon == std::string::npos) {
+      continue;
+    }
+    if (Lower(line.substr(0, colon)) == Lower(name)) {
+      std::string value = line.substr(colon + 1);
+      const auto first = value.find_first_not_of(" \t");
+      return first == std::string::npos ? std::string() : value.substr(first);
+    }
+  }
+  return {};
+}
+
+}  // namespace
+
+Dashboard::Dashboard(asio::io_context& ioc, std::uint16_t port, DashboardApi api)
+    : ioc_(ioc), port_(port), api_(std::move(api)), acceptor_(ioc) {}
+
+Dashboard::~Dashboard() { Stop(); }
+
+bool Dashboard::Start() {
+  boost::system::error_code ec;
+  const tcp::endpoint endpoint(asio::ip::make_address("127.0.0.1"), port_);
+  acceptor_.open(endpoint.protocol(), ec);
+  if (!ec) {
+    acceptor_.set_option(tcp::acceptor::reuse_address(true), ec);
+  }
+  if (!ec) {
+    acceptor_.bind(endpoint, ec);
+  }
+  if (!ec) {
+    acceptor_.listen(16, ec);
+  }
+  if (ec) {
+    SPDLOG_WARN("dashboard: cannot listen on 127.0.0.1:{}: {}", port_,
+        ec.message());
+    return false;
+  }
+  DoAccept();
+  return true;
+}
+
+void Dashboard::Stop() {
+  boost::system::error_code ignored;
+  acceptor_.close(ignored);
+}
+
+std::string Dashboard::Handle(
+    const std::string& head, const std::string& body) const {
+  std::istringstream first(head);
+  std::string method;
+  std::string target;
+  first >> method >> target;
+  if (method.empty() || target.empty()) {
+    return Response(400, "Bad Request", "text/plain", "bad request");
+  }
+
+  // DNS-rebinding guard: only our own address as the Host.
+  const std::string host = Lower(Header(head, "Host"));
+  const std::string port = std::to_string(port_);
+  if (host != "127.0.0.1:" + port && host != "localhost:" + port) {
+    return Response(403, "Forbidden", "text/plain", "forbidden");
+  }
+
+  std::string path = target;
+  std::string query;
+  if (const auto q = target.find('?'); q != std::string::npos) {
+    path = target.substr(0, q);
+    query = target.substr(q + 1);
+  }
+
+  if (method == "GET") {
+    if (path == "/" || path == "/index.html") {
+      return Response(200, "OK", "text/html; charset=utf-8", kPage);
+    }
+    if (path == "/api/state") {
+      return Response(200, "OK", "application/json; charset=utf-8",
+          api_.state_json ? api_.state_json() : "{}");
+    }
+    return Response(404, "Not Found", "text/plain", "not found");
+  }
+
+  if (method == "POST") {
+    // CSRF guard: a foreign web page cannot add this header cross-origin.
+    if (Header(head, "X-Requested-With") != "fptn") {
+      return Response(403, "Forbidden", "text/plain", "forbidden");
+    }
+    constexpr const char kPrefix[] = "/api/";
+    if (path.rfind(kPrefix, 0) != 0 || !api_.post) {
+      return Response(404, "Not Found", "text/plain", "not found");
+    }
+    switch (api_.post(path.substr(sizeof(kPrefix) - 1), query, body)) {
+      case 202:
+        return Response(202, "Accepted", "text/plain", "accepted");
+      case 400:
+        return Response(400, "Bad Request", "text/plain", "bad request");
+      case 409:
+        return Response(409, "Conflict", "text/plain", "busy");
+      default:
+        return Response(404, "Not Found", "text/plain", "not found");
+    }
+  }
+  return Response(405, "Method Not Allowed", "text/plain", "method not allowed");
+}
+
+namespace {
+
+// One request: read the head, answer, close.
+class DashboardConnection : public std::enable_shared_from_this<DashboardConnection> {
+ public:
+  DashboardConnection(tcp::socket socket, const Dashboard& dashboard)
+      : socket_(std::move(socket)), dashboard_(dashboard) {}
+
+  void Start() {
+    auto self = shared_from_this();
+    asio::async_read_until(socket_, asio::dynamic_buffer(buffer_, kMaxHead),
+        "\r\n\r\n",
+        [self](const boost::system::error_code& ec, std::size_t n) {
+          if (ec) {
+            return;
+          }
+          self->head_size_ = n;
+          self->ReadBody();
+        });
+  }
+
+ private:
+  static constexpr std::size_t kMaxHead = 16 * 1024;
+  static constexpr std::size_t kMaxBody = 1024 * 1024;  // a token can be huge
+
+  void ReadBody() {
+    const std::string head = buffer_.substr(0, head_size_);
+    std::size_t length = 0;
+    const std::string text = Header(head, "Content-Length");
+    if (!text.empty()) {
+      length = static_cast<std::size_t>(std::strtoull(text.c_str(), nullptr, 10));
+    }
+    if (length > kMaxBody) {
+      Reply(Response(413, "Payload Too Large", "text/plain", "too large"));
+      return;
+    }
+    const std::size_t have = buffer_.size() - head_size_;
+    if (have >= length) {
+      Finish();
+      return;
+    }
+    auto self = shared_from_this();
+    asio::async_read(socket_,
+        asio::dynamic_buffer(buffer_, kMaxHead + kMaxBody),
+        asio::transfer_exactly(length - have),
+        [self](const boost::system::error_code& ec, std::size_t) {
+          if (!ec) {
+            self->Finish();
+          }
+        });
+  }
+
+  void Finish() {
+    const std::string head = buffer_.substr(0, head_size_);
+    const std::string body = buffer_.substr(head_size_);
+    Reply(dashboard_.Handle(head, body));
+  }
+
+  void Reply(std::string response) {
+    response_ = std::move(response);
+    auto self = shared_from_this();
+    asio::async_write(socket_, asio::buffer(response_),
+        [self](const boost::system::error_code&, std::size_t) {
+          boost::system::error_code ignored;
+          self->socket_.shutdown(tcp::socket::shutdown_both, ignored);
+        });
+  }
+
+  tcp::socket socket_;
+  const Dashboard& dashboard_;
+  std::string buffer_;
+  std::size_t head_size_ = 0;
+  std::string response_;
+};
+
+}  // namespace
+
+void Dashboard::DoAccept() {
+  acceptor_.async_accept(
+      [this](const boost::system::error_code& ec, tcp::socket socket) {
+        if (ec == asio::error::operation_aborted) {
+          return;
+        }
+        if (!ec) {
+          std::make_shared<DashboardConnection>(std::move(socket), *this)
+              ->Start();
+        }
+        DoAccept();
+      });
+}
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/dashboard.h b/src/fptn-vless/dashboard.h

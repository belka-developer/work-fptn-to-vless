@@ -0,0 +1,153 @@
+project(fptn-vless)
+
+include(FetchContent)
+
+# ---------------------------------------------------------------------------
+# lwIP: userspace TCP/IP stack. Pinned to the release the tests were run with.
+# ---------------------------------------------------------------------------
+FetchContent_Declare(
+  lwip
+  GIT_REPOSITORY https://github.com/lwip-tcpip/lwip.git
+  GIT_TAG STABLE-2_2_1_RELEASE
+  GIT_SHALLOW TRUE)
+FetchContent_GetProperties(lwip)
+if(NOT lwip_POPULATED)
+  FetchContent_Populate(lwip)
+endif()
+set(LWIP_DIR "${lwip_SOURCE_DIR}")
+
+add_library(
+  fptn_lwip STATIC
+  ${LWIP_DIR}/src/core/init.c
+  ${LWIP_DIR}/src/core/def.c
+  ${LWIP_DIR}/src/core/dns.c
+  ${LWIP_DIR}/src/core/inet_chksum.c
+  ${LWIP_DIR}/src/core/ip.c
+  ${LWIP_DIR}/src/core/mem.c
+  ${LWIP_DIR}/src/core/memp.c
+  ${LWIP_DIR}/src/core/netif.c
+  ${LWIP_DIR}/src/core/pbuf.c
+  ${LWIP_DIR}/src/core/raw.c
+  ${LWIP_DIR}/src/core/stats.c
+  ${LWIP_DIR}/src/core/sys.c
+  ${LWIP_DIR}/src/core/tcp.c
+  ${LWIP_DIR}/src/core/tcp_in.c
+  ${LWIP_DIR}/src/core/tcp_out.c
+  ${LWIP_DIR}/src/core/timeouts.c
+  ${LWIP_DIR}/src/core/udp.c
+  ${LWIP_DIR}/src/core/ipv4/icmp.c
+  ${LWIP_DIR}/src/core/ipv4/ip4.c
+  ${LWIP_DIR}/src/core/ipv4/ip4_addr.c
+  ${LWIP_DIR}/src/core/ipv4/ip4_frag.c)
+target_include_directories(
+  fptn_lwip PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/lwip_port"
+                   "${LWIP_DIR}/src/include")
+# The root project builds with -Werror/-pedantic or /WX; third-party C code is
+# not subject to that.
+set_target_properties(fptn_lwip PROPERTIES COMPILE_WARNING_AS_ERROR OFF)
+if(MSVC)
+  target_compile_options(fptn_lwip PRIVATE /W0 /WX-)
+else()
+  target_compile_options(fptn_lwip PRIVATE -w -Wno-error)
+endif()
+
+# ---------------------------------------------------------------------------
+# fptn-vless
+#
+# FPTN_USERSPACE_TUN swaps the TunInterface type (see net_interface.h), so every
+# translation unit that sees VpnManager::Config must be compiled WITH it. That
+# is why vpn_manager.cpp & friends are compiled again here instead of being
+# linked from fptn-client-cli (mixing the two would be an ODR violation).
+# ---------------------------------------------------------------------------
+set(FPTN_CLIENT_DIR "${CMAKE_SOURCE_DIR}/src/fptn-client")
+
+find_package(OpenSSL REQUIRED)
+find_package(argparse REQUIRED)
+find_package(spdlog REQUIRED)
+find_package(fmt REQUIRED)
+find_package(Boost REQUIRED COMPONENTS random filesystem process locale)
+find_package(ZLIB REQUIRED)
+find_package(httplib REQUIRED)
+find_package(libidn2 REQUIRED)
+find_package(re2 REQUIRED)
+find_package(nlohmann_json REQUIRED)
+find_package(brotli REQUIRED)
+find_path(BROTLI_INCLUDE_DIR "brotli/decode.h" REQUIRED)
+find_library(BROTLI_DEC_LIB NAMES brotlidec REQUIRED)
+find_library(BROTLI_COMMON_LIB NAMES brotlicommon REQUIRED)
+find_library(BROTLI_ENC_LIB NAMES brotlienc REQUIRED)
+
+add_executable(
+  "${PROJECT_NAME}"
+  fptn-vless.cpp
+  userspace_stack.cpp
+  userspace_stack.h
+  userspace_tun_device.h
+  vless_server.cpp
+  vless_server.h
+  # shared with fptn-client-cli, recompiled with FPTN_USERSPACE_TUN
+  "${FPTN_CLIENT_DIR}/vpn/vpn_manager.cpp"
+  "${FPTN_CLIENT_DIR}/vpn/http/client.cpp"
+  "${FPTN_CLIENT_DIR}/routing/route_manager.cpp"
+  "${FPTN_CLIENT_DIR}/config/config_file.cpp"
+  "${FPTN_CLIENT_DIR}/plugins/split/tunneling.cpp"
+  "${FPTN_CLIENT_DIR}/utils/speed_estimator/speed_estimator.cpp")
+
+target_compile_definitions("${PROJECT_NAME}" PRIVATE FPTN_USERSPACE_TUN=1)
+if(MSVC)
+  # This code was only checked with GCC/MinGW. Do not let an MSVC-only
+  # warning stop the build (the root project forces /WX).
+  set_target_properties("${PROJECT_NAME}" PROPERTIES COMPILE_WARNING_AS_ERROR
+                                                     OFF)
+  target_compile_options("${PROJECT_NAME}" PRIVATE /WX-)
+endif()
+# fptn-client sources include each other relative to src/fptn-client
+target_include_directories("${PROJECT_NAME}" PRIVATE "${FPTN_CLIENT_DIR}"
+                                                     "${BROTLI_INCLUDE_DIR}")
+
+if(WIN32)
+  # no Wintun here on purpose: this program never creates an adapter
+  set(PLATFORM_LIBS rpcrt4 iphlpapi Kernel32.lib ws2_32)
+else()
+  set(PLATFORM_LIBS "")
+endif()
+
+target_link_libraries(
+  "${PROJECT_NAME}"
+  PRIVATE fptn_lwip
+          ZLIB::ZLIB
+          Boost::boost
+          Boost::random
+          Boost::filesystem
+          Boost::process
+          Boost::locale
+          OpenSSL::SSL
+          OpenSSL::Crypto
+          argparse::argparse
+          nlohmann_json::nlohmann_json
+          spdlog::spdlog
+          fmt::fmt
+          libidn2::libidn2
+          re2::re2
+          fptn-protocol-lib_static
+          "${BROTLI_DEC_LIB}"
+          "${BROTLI_COMMON_LIB}"
+          ${PLATFORM_LIBS})
+
+install(TARGETS "${PROJECT_NAME}" DESTINATION bin)
+
+# --- tests (no FPTN server needed) -----------------------------------------
+option(FPTN_VLESS_BUILD_TESTS "Build the fptn-vless loopback test" ON)
+if(FPTN_VLESS_BUILD_TESTS AND UNIX)
+  add_executable(fptn_vless_echo_peer test/echo_peer.cpp)
+  target_link_libraries(fptn_vless_echo_peer PRIVATE fptn_lwip)
+
+  add_executable(fptn_vless_loopback_test test/loopback_test.cpp
+                                          userspace_stack.cpp vless_server.cpp)
+  target_link_libraries(
+    fptn_vless_loopback_test PRIVATE fptn_lwip spdlog::spdlog fmt::fmt
+                                     Boost::boost)
+  add_test(NAME fptn_vless_loopback
+           COMMAND fptn_vless_loopback_test
+           WORKING_DIRECTORY $<TARGET_FILE_DIR:fptn_vless_echo_peer>)
+endif()
diff --git a/src/fptn-vless/README.md b/src/fptn-vless/README.md
new file mode 100644
index 0000000..902e952
--- /dev/null
+++ b/src/fptn-vless/README.md
@@ -0,0 +1,56 @@
+# fptn-vless
+
+Консольная утилита: подключается к FPTN по токену и отдаёт туннель в локальную
+сеть как **VLESS-inbound**. На ПК не создаётся адаптер, не меняются маршруты и
+DNS: туннель заканчивается в userspace-стеке (lwIP). Закрыли окно, и система
+осталась как была.
+
+```
+LAN-клиент --VLESS--> fptn-vless.exe --[lwIP]--> libfptn --TLS--> FPTN-сервер
+```
+
+## Использование
+
+```
+fptn-vless.exe --access-token <токен>
+fptn-vless.exe --access-token <токен> --server 2 --port 10800
+```
+
+Без `--server` программа покажет серверы из токена и спросит номер
+(Enter = автоматически, самый быстрый). После подключения печатает ссылку:
+
+```
+vless://<uuid>@<IP-этого-ПК>:10800?encryption=none&security=none&type=tcp#fptn-<сервер>
+```
+
+UUID получается из токена, то есть он стабилен между запусками (или задайте `--uuid`).
+
+| Опция | По умолчанию |
+|---|---|
+| `--listen` | `0.0.0.0` |
+| `--port` | `10800` |
+| `--bypass-method` | `sni-spoofing-yandex-26-4` |
+| `--connection-strategy` | `rolling-tunnel` |
+| `--sni`, `--mtu-size`, `--uuid` | как в `fptn-client-cli` |
+
+## Что изменено в upstream (всего +19/−5 строк)
+
+* `common/network/net_interface.h`: при `FPTN_USERSPACE_TUN` вместо Wintun/Linux TUN
+  используется `UserspaceTunDevice`.
+* `fptn-client/vpn/vpn_manager.cpp`: `route_manager` стал необязательным (nullptr).
+* `CMakeLists.txt`: подключён `src/fptn-vless`.
+
+Остальное (`src/fptn-vless/`) добавлено, существующий код не переписан.
+
+## Ограничения
+
+* Только TCP. VLESS-UDP (QUIC/HTTP3 с клиентов) не поддержан, приложения откатятся на TCP.
+* Только IPv4 цели. Домены резолвятся внутри туннеля через DNS сервера FPTN.
+* VLESS без TLS: только для доверенной LAN. Не пробрасывайте порт наружу.
+* Брандмауэр Windows спросит разрешение на входящие: разрешите для частных сетей.
+
+## Тесты
+
+`fptn_vless_loopback_test` проверяет весь путь VLESS -> lwIP -> IP-пакеты -> второй
+lwIP без настоящего FPTN-сервера: эхо, 4 МиБ вниз/вверх с проверкой данных,
+8 параллельных потоков, неверный UUID, таймаут, закрытый порт.
diff --git a/src/fptn-vless/fptn-vless.cpp b/src/fptn-vless/fptn-vless.cpp
new file mode 100644
index 0000000..d69c6b5
--- /dev/null
+++ b/src/fptn-vless/fptn-vless.cpp
@@ -0,0 +1,346 @@
+/*
+ * fptn-vless: connect to an FPTN server with an access token and expose the
+ * tunnel to the LAN as a plain VLESS inbound.
+ *
+ * Unlike fptn-client-cli this program never creates a network adapter and
+ * never touches routes or DNS: the tunnel terminates in a userspace TCP/IP
+ * stack (lwIP). Closing it - cleanly or not - leaves Windows exactly as it was.
+ */
+
+#include <algorithm>
+#include <cctype>
+#include <functional>
+#include <iostream>
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <argparse/argparse.hpp>
+#include <boost/asio.hpp>
+#include <fmt/format.h>  // NOLINT(build/include_order)
+#include <openssl/sha.h>
+
+#include "common/logger/logger.h"
+#include "common/network/ip_address.h"
+#include "common/network/net_interface.h"
+
+#include "config/config_file.h"
+#include "fptn-protocol-lib/https/censorship_strategy.h"
+#include "fptn-protocol-lib/time/time_provider.h"
+#include "routing/route_manager.h"  // ResolveDomain only
+#include "vpn/vpn_manager.h"
+
+#include "fptn-vless/userspace_stack.h"
+#include "fptn-vless/vless_server.h"
+
+namespace {
+
+using fptn::protocol::https::CensorshipStrategy;
+using fptn::protocol::connection::strategies::ConnectionStrategy;
+
+const std::map<std::string, CensorshipStrategy>& BypassMethods() {
+  static const std::map<std::string, CensorshipStrategy> kMethods = {
+      {"obfuscation", CensorshipStrategy::kTlsObfuscator},
+      {"sni-spoofing-chrome-149", CensorshipStrategy::kSniRealityModeChrome149},
+      {"sni-spoofing-chrome-148", CensorshipStrategy::kSniRealityModeChrome148},
+      {"sni-spoofing-chrome-147", CensorshipStrategy::kSniRealityModeChrome147},
+      {"sni-spoofing-chrome-146", CensorshipStrategy::kSniRealityModeChrome146},
+      {"sni-spoofing-chrome-145", CensorshipStrategy::kSniRealityModeChrome145},
+      {"sni-spoofing-firefox-151",
+          CensorshipStrategy::kSniRealityModeFirefox151},
+      {"sni-spoofing-firefox-150",
+          CensorshipStrategy::kSniRealityModeFirefox150},
+      {"sni-spoofing-firefox-149",
+          CensorshipStrategy::kSniRealityModeFirefox149},
+      {"sni-spoofing-yandex-26-4", CensorshipStrategy::kSniRealityModeYandex26_4},
+      {"sni-spoofing-yandex-26-3", CensorshipStrategy::kSniRealityModeYandex26_3},
+      {"sni-spoofing-yandex-25", CensorshipStrategy::kSniRealityModeYandex25},
+      {"sni-spoofing-yandex-24", CensorshipStrategy::kSniRealityModeYandex24},
+      {"sni-spoofing-safari-26-5", CensorshipStrategy::kSniRealityModeSafari26_5},
+      {"sni-spoofing-safari-26-4", CensorshipStrategy::kSniRealityModeSafari26_4},
+  };
+  return kMethods;
+}
+
+const std::map<std::string, ConnectionStrategy>& ConnectionStrategies() {
+  static const std::map<std::string, ConnectionStrategy> kStrategies = {
+      {"rolling-tunnel", ConnectionStrategy::kSingleRollingTunnel},
+      {"dual-rolling-tunnel", ConnectionStrategy::kDualRollingTunnel},
+      {"triple-rolling-tunnel", ConnectionStrategy::kTripleRollingTunnel},
+  };
+  return kStrategies;
+}
+
+// Same token -> same UUID, so the client profile on your phone/PC survives
+// restarts without storing anything on disk. Override with --uuid.
+fptn::vless::Uuid DeriveUuid(const std::string& token) {
+  unsigned char digest[SHA256_DIGEST_LENGTH];
+  SHA256(reinterpret_cast<const unsigned char*>(token.data()), token.size(),
+      digest);
+  fptn::vless::Uuid uuid{};
+  std::copy(digest, digest + 16, uuid.begin());
+  uuid[6] = (uuid[6] & 0x0F) | 0x50;
+  uuid[8] = (uuid[8] & 0x3F) | 0x80;
+  return uuid;
+}
+
+bool IsNumber(const std::string& s) {
+  return !s.empty() && std::all_of(s.begin(), s.end(), [](unsigned char c) {
+    return std::isdigit(c) != 0;
+  });
+}
+
+}  // namespace
+
+int main(int argc, char* argv[]) {
+  argparse::ArgumentParser args("fptn-vless", FPTN_VERSION);
+  args.add_argument("--access-token").required().help("FPTN access token");
+  args.add_argument("--server")
+      .default_value("")
+      .help(
+          "Server name or its number from the list. Empty: show the list and "
+          "ask (Enter = pick automatically)");
+  args.add_argument("--listen")
+      .default_value("0.0.0.0")
+      .help("Address of the VLESS inbound (0.0.0.0 = whole LAN)");
+  args.add_argument("--port").default_value(10800).scan<'i', int>().help(
+      "Port of the VLESS inbound");
+  args.add_argument("--uuid")
+      .default_value("")
+      .help("VLESS user id. Empty: derived from the access token");
+  args.add_argument("--sni").default_value(FPTN_DEFAULT_SNI).help("TLS SNI");
+  args.add_argument("--bypass-method")
+      .default_value("sni-spoofing-yandex-26-4")
+      .help("Same values as fptn-client-cli --bypass-method");
+  args.add_argument("--connection-strategy")
+      .default_value("rolling-tunnel")
+      .help("rolling-tunnel | dual-rolling-tunnel | triple-rolling-tunnel");
+  args.add_argument("--mtu-size").default_value(FPTN_DEFAULT_MTU_SIZE)
+      .scan<'i', int>().help("MTU of the userspace stack");
+
+  try {
+    args.parse_args(argc, argv);
+  } catch (const std::exception& err) {
+    std::cerr << err.what() << std::endl << args;
+    return EXIT_FAILURE;
+  }
+
+  if (!fptn::logger::init("fptn-vless")) {
+    std::cerr << "File logging unavailable, logging to console only\n";
+  }
+  SPDLOG_INFO("fptn-vless {} started", FPTN_VERSION);
+  fptn::time::TimeProvider::Instance();
+
+  try {
+    /* ---- options ---- */
+    const auto sni = args.get<std::string>("--sni");
+    const auto bypass_name = args.get<std::string>("--bypass-method");
+    const auto strategy_name = args.get<std::string>("--connection-strategy");
+    const auto bypass_it = BypassMethods().find(bypass_name);
+    const auto strategy_it = ConnectionStrategies().find(strategy_name);
+    if (bypass_it == BypassMethods().end()) {
+      SPDLOG_ERROR("Unknown --bypass-method '{}'", bypass_name);
+      return EXIT_FAILURE;
+    }
+    if (strategy_it == ConnectionStrategies().end()) {
+      SPDLOG_ERROR("Unknown --connection-strategy '{}'", strategy_name);
+      return EXIT_FAILURE;
+    }
+    const int mtu_size = args.get<int>("--mtu-size");
+    const int port = args.get<int>("--port");
+    if (port < 1 || port > 65535 || mtu_size < 576 || mtu_size > 65535) {
+      SPDLOG_ERROR("--port or --mtu-size is out of range");
+      return EXIT_FAILURE;
+    }
+    const auto access_token = args.get<std::string>("--access-token");
+    fptn::vless::Uuid uuid = DeriveUuid(access_token);
+    if (const auto text = args.get<std::string>("--uuid"); !text.empty()) {
+      if (!fptn::vless::ParseUuid(text, uuid)) {
+        SPDLOG_ERROR("--uuid is not a valid UUID");
+        return EXIT_FAILURE;
+      }
+    }
+
+    /* ---- token -> server list -> choice ---- */
+    fptn::config::ConfigFile config(access_token, sni, bypass_it->second);
+    config.Parse();
+    const auto& servers = config.GetServers();
+    if (servers.empty()) {
+      SPDLOG_ERROR("The token contains no servers");
+      return EXIT_FAILURE;
+    }
+
+    std::string choice = args.get<std::string>("--server");
+    if (choice.empty()) {
+      std::cout << "\nServers in this token:\n";
+      for (std::size_t i = 0; i < servers.size(); ++i) {
+        std::cout << fmt::format("  {:>2}. {}  ({}:{})\n", i + 1,
+            servers[i].name, servers[i].host, servers[i].port);
+      }
+      std::cout << "Select server number or name [Enter = automatic]: "
+                << std::flush;
+      std::getline(std::cin, choice);
+    }
+    if (IsNumber(choice)) {
+      const auto index = static_cast<std::size_t>(std::stoul(choice));
+      if (index < 1 || index > servers.size()) {
+        SPDLOG_ERROR("No server number {}", index);
+        return EXIT_FAILURE;
+      }
+      choice = servers[index - 1].name;
+    }
+
+    fptn::utils::speed_estimator::ServerInfo selected_server;
+    std::string pre_obtained_token;
+    if (!choice.empty()) {
+      auto server = config.GetServer(choice);
+      if (!server.has_value()) {
+        SPDLOG_ERROR("Server '{}' does not exist in the token", choice);
+        return EXIT_FAILURE;
+      }
+      selected_server = std::move(*server);
+    } else {
+      auto login_result = config.FindServerByLogin(10);
+      if (!login_result) {
+        SPDLOG_ERROR("All servers unavailable!");
+        return EXIT_FAILURE;
+      }
+      selected_server = login_result->server;
+      pre_obtained_token = std::move(login_result->access_token);
+    }
+
+    const auto server_ip = fptn::routing::ResolveDomain(selected_server.host);
+    if (server_ip.IsEmpty()) {
+      SPDLOG_ERROR("DNS resolve error: {}", selected_server.host);
+      return EXIT_FAILURE;
+    }
+
+    /* ---- login (identical to fptn-client-cli) ---- */
+    const auto tun_ipv4 = fptn::common::network::IPv4Address::Create(
+        FPTN_CLIENT_DEFAULT_ADDRESS_IP4);
+    const auto tun_ipv6 = fptn::common::network::IPv6Address::Create(
+        FPTN_CLIENT_DEFAULT_ADDRESS_IP6);
+
+    auto http_client = std::make_unique<fptn::vpn::http::Client>(
+        fptn::protocol::https::ConnectionConfig{
+            .common ={
+                    .server_ip = server_ip,
+                    .server_port =
+                        static_cast<std::uint16_t>(selected_server.port),
+                    .sni = sni,
+                    .md5_fingerprint = selected_server.md5_fingerprint,
+                    .client_version = FPTN_VERSION,
+                    .censorship_strategy = bypass_it->second,
+                    .tun_interface_address_ipv4 = tun_ipv4,
+                    .tun_interface_address_ipv6 = tun_ipv6,
+                }},
+        strategy_it->second);
+    if (!pre_obtained_token.empty()) {
+      http_client->SetAccessToken(pre_obtained_token);
+    }
+    if (!http_client->Login(config.GetUsername(), config.GetPassword())) {
+      SPDLOG_ERROR("Login failed (code {}): {}", http_client->LatestErrorCode(),
+          http_client->LatestError());
+      return EXIT_FAILURE;
+    }
+    const auto [dns_ipv4, dns_ipv6] = http_client->GetDns();
+    if (dns_ipv4.IsEmpty()) {
+      SPDLOG_ERROR("The server did not provide a DNS address");
+      return EXIT_FAILURE;
+    }
+
+    /* ---- userspace stack instead of an OS adapter ---- */
+    auto& stack = fptn::vless::UserspaceStack::Instance();
+    fptn::vless::UserspaceStack::Config stack_config;
+    stack_config.ipv4 = tun_ipv4.ToString();
+    stack_config.dns_ipv4 = dns_ipv4.ToString();
+    stack_config.mtu = mtu_size;
+    if (!stack.Start(stack_config)) {
+      SPDLOG_ERROR("Cannot start the userspace network stack");
+      return EXIT_FAILURE;
+    }
+
+    auto virtual_network_interface =
+        std::make_shared<fptn::common::network::TunInterface>(
+            fptn::common::network::TunInterface::Config{
+                .name = "fptn-userspace",
+                .mtu_size = mtu_size,
+                .using_rate_calculator = false,
+                .ipv4_addr = tun_ipv4,
+                .ipv4_netmask = 32,
+                .ipv6_addr = tun_ipv6,
+                .ipv6_netmask = 126});
+
+    // No route manager, no plugins: nothing is changed on this machine.
+    fptn::vpn::VpnManager vpn_client(
+        fptn::vpn::VpnManager::Config{.http_client = std::move(http_client),
+            .route_manager = nullptr,
+            .virtual_net_interface = virtual_network_interface,
+            .plugins = {}});
+    if (!vpn_client.Start()) {
+      SPDLOG_ERROR("Cannot start the FPTN connection");
+      stack.Stop();
+      return EXIT_FAILURE;
+    }
+
+    /* ---- VLESS inbound ---- */
+    boost::asio::io_context ioc;
+    fptn::vless::VlessServer::Config vless_config;
+    vless_config.listen_address = args.get<std::string>("--listen");
+    vless_config.port = static_cast<std::uint16_t>(port);
+    vless_config.uuid = uuid;
+    fptn::vless::VlessServer vless(ioc, vless_config, stack);
+    if (!vless.Start()) {
+      vpn_client.Stop();
+      stack.Stop();
+      return EXIT_FAILURE;
+    }
+
+    const std::string host_hint =
+        vless_config.listen_address == "0.0.0.0"
+            ? std::string("<IP-of-this-PC>")
+            : vless_config.listen_address;
+    std::cout << fmt::format(
+        "\nConnected to FPTN server '{}'. VLESS inbound is ready:\n\n"
+        "  vless://{}@{}:{}?encryption=none&security=none&type=tcp#fptn-{}\n\n"
+        "Protocol vless, transport tcp, security none. Press Ctrl+C to stop.\n"
+        "Windows may ask to allow the firewall - allow it for private "
+        "networks.\n\n",
+        selected_server.name, fptn::vless::UuidToString(uuid), host_hint, port,
+        selected_server.name);
+
+    boost::asio::signal_set signals(ioc, SIGINT, SIGTERM);
+    signals.async_wait([&](auto, auto) { ioc.stop(); });
+
+    boost::asio::steady_timer watchdog(ioc);
+    std::function<void()> check = [&]() {
+      if (!vpn_client.IsStarted()) {
+        SPDLOG_ERROR("FPTN connection lost! Exiting...");
+        ioc.stop();
+        return;
+      }
+      watchdog.expires_after(std::chrono::seconds(1));
+      watchdog.async_wait([&](const boost::system::error_code& ec) {
+        if (!ec) {
+          check();
+        }
+      });
+    };
+    check();
+    ioc.run();
+
+    /* ---- shutdown: nothing to roll back on the OS ---- */
+    vless.Stop();
+    vpn_client.Stop();
+    stack.Stop();
+    spdlog::shutdown();
+    return EXIT_SUCCESS;
+  } catch (const std::exception& ex) {
+    SPDLOG_ERROR("An error occurred: {}. Exiting...", ex.what());
+  } catch (...) {
+    SPDLOG_ERROR("An unknown error occurred. Exiting...");
+  }
+  return EXIT_FAILURE;
+}

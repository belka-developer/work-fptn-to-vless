+#pragma once
+
+/*
+ * What the application needs from "a set of FPTN servers". TunnelManager is
+ * the real implementation; tests use a fake one.
+ */
+
+#include <cstddef>
+#include <string>
+#include <vector>
+
+#include "fptn-vless/failover.h"
+
+namespace fptn::vless {
+
+class ITunnels {
+ public:

+#include "fptn-vless/app.h"
+
+#include <algorithm>
+#include <cctype>
+#include <future>
+#include <utility>
+
+#include <fmt/format.h>  // NOLINT(build/include_order)
+#include <nlohmann/json.hpp>
+#include <openssl/sha.h>
+#include <spdlog/spdlog.h>
+
+#include "fptn-vless/events.h"
+
+namespace fptn::vless {
+
+std::string CleanToken(const std::string& raw) {
+  std::string token;
+  for (const unsigned char c : raw) {
+    if (std::isspace(c) == 0 && c != '"' && c != '\'') {
+      token.push_back(static_cast<char>(c));
+    }
+  }
+  return token;
+}
+
+Uuid DeriveUuid(const std::string& token) {
+  unsigned char digest[SHA256_DIGEST_LENGTH];
+  SHA256(reinterpret_cast<const unsigned char*>(token.data()), token.size(),
+      digest);
+  Uuid uuid{};
+  std::copy(digest, digest + 16, uuid.begin());
+  uuid[6] = (uuid[6] & 0x0F) | 0x50;
+  uuid[8] = (uuid[8] & 0x3F) | 0x80;
+  return uuid;
+}
+
+namespace {
+
+std::string PercentEncode(const std::string& text) {
+  static const char kHex[] = "0123456789ABCDEF";
+  std::string out;
+  for (const unsigned char c : text) {
+    if (std::isalnum(c) != 0 || c == '-' || c == '.' || c == '_' || c == '~') {
+      out.push_back(static_cast<char>(c));
+    } else {
+      out.push_back('%');
+      out.push_back(kHex[c >> 4]);
+      out.push_back(kHex[c & 0x0F]);
+    }
+  }
+  return out;
+}
+
+std::string Lower(std::string text) {
+  std::transform(text.begin(), text.end(), text.begin(),
+      [](unsigned char c) { return static_cast<char>(std::tolower(c)); });
+  return text;
+}
+
+const char* PhaseName(int phase) {
+  static const char* kNames[] = {
+      "no_token", "scanning", "ready", "connecting", "connected"};
+  return kNames[phase];
+}
+
+}  // namespace
+
+std::string MakeLink(const Uuid& uuid, const std::string& host, int port) {
+  return fmt::format(
+      "vless://{}@{}:{}?encryption=none&security=none&type=tcp&headerType=none"
+      "#{}",
+      UuidToString(uuid), host, port, PercentEncode("fptn-vless"));
+}
+
+App::App(boost::asio::io_context& ioc,
+    UserspaceStack& stack,
+    SettingsStore& store,
+    AppOptions options,
+    AppDeps deps)
+    : ioc_(ioc),
+      stack_(stack),
+      store_(store),
+      options_(std::move(options)),
+      deps_(std::move(deps)) {}
+
+App::~App() { Shutdown(); }
+
+void App::SetPhase(Phase phase, const std::string& message) {
+  const std::lock_guard<std::mutex> lock(mu_);
+  phase_ = phase;
+  message_ = message;
+}
+
+// Runs `fn` on the io_context thread and waits (asio objects are not thread
+// safe). If the io_context is not running any more we are the only thread.
+void App::OnIoc(const std::function<void()>& fn) {
+  if (ioc_.stopped()) {
+    fn();
+    return;
+  }
+  auto done = std::make_shared<std::promise<void>>();
+  auto finished = done->get_future();
+  boost::asio::post(ioc_, [fn, done]() {
+    fn();
+    done->set_value();
+  });
+  if (finished.wait_for(std::chrono::seconds(5)) != std::future_status::ready) {
+    SPDLOG_WARN("app: the network loop did not answer in time");
+  }
+}
+
+bool App::Run(const std::string& label, std::function<void()> action) {
+  std::thread finished;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    if (shut_down_ || !busy_.empty()) {
+      return false;
+    }
+    finished = std::move(worker_);  // the previous action is done
+    busy_ = label;
+  }
+  if (finished.joinable()) {
+    finished.join();
+  }
+  std::thread worker([this, action = std::move(action)]() {
+    try {
+      action();
+    } catch (const std::exception& ex) {
+      SPDLOG_ERROR("app action failed: {}", ex.what());
+    } catch (...) {
+      SPDLOG_ERROR("app action failed");
+    }
+    const std::lock_guard<std::mutex> lock(mu_);
+    busy_.clear();
+  });
+  const std::lock_guard<std::mutex> lock(mu_);
+  worker_ = std::move(worker);
+  return true;
+}
+
+void App::Start(const std::optional<std::string>& cli_token) {
+  const Settings saved = store_.Load();
+  std::string token = cli_token ? CleanToken(*cli_token) : saved.token;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    token_saved_ = !saved.token.empty();
+    remember_ = token_saved_;
+  }
+  if (token.empty()) {
+    SetPhase(Phase::kNoToken);
+    return;
+  }
+  Run("Подключение...", [this, token, saved]() {
+    if (!Setup(token)) {
+      return;
+    }
+    // --server wins, then the choice remembered from last time.
+    const bool explicit_choice = !options_.preferred_server.empty();
+    const std::string wanted =
+        explicit_choice ? options_.preferred_server : saved.server;
+    std::optional<std::size_t> index;
+    std::shared_ptr<ITunnels> tunnels;
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      tunnels = tunnels_;
+    }
+    if (!wanted.empty() && (explicit_choice || saved.pinned)) {
+      const auto names = tunnels->Names();
+      for (std::size_t i = 0; i < names.size(); ++i) {
+        if (Lower(names[i]) == Lower(wanted)) {
+          index = i;
+        }
+      }
+    }
+    ConnectTo(index);
+  });
+}
+
+void App::Teardown(bool drop_vless) {
+  std::shared_ptr<FailoverController> controller;
+  std::shared_ptr<ITunnels> tunnels;
+  std::unique_ptr<VlessServer> vless;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = std::move(controller_);
+    tunnels = std::move(tunnels_);
+    if (drop_vless) {
+      vless = std::move(vless_);
+    }
+  }
+  if (controller) {
+    controller->Stop();
+  }
+  if (tunnels) {
+    tunnels->Shutdown();
+  }
+  if (vless) {
+    OnIoc([&vless]() {
+      vless->Stop();
+      vless.reset();
+    });
+  }
+}
+
+bool App::Setup(const std::string& token) {
+  Teardown(true);
+  SetPhase(Phase::kScanning, "Разбор токена...");
+  std::shared_ptr<ITunnels> tunnels;
+  try {
+    tunnels = deps_.make_tunnels(token);
+  } catch (const std::exception& ex) {
+    Notify("Токен не принят: {}", ex.what());
+    SetPhase(Phase::kNoToken, std::string("Токен не принят: ") + ex.what());
+    return false;
+  }
+  if (!tunnels || tunnels->Names().empty()) {
+    SetPhase(Phase::kNoToken, "В токене нет серверов");
+    return false;
+  }
+  SetPhase(Phase::kScanning, "Замер отклика серверов...");
+  FailoverController::Hooks hooks;
+  hooks.probe_all = [tunnels]() { return tunnels->ProbeAll(); };
+  hooks.connect = [tunnels](std::size_t i) { return tunnels->Connect(i); };
+  hooks.tunnel_down = [tunnels]() { return tunnels->IsDown(); };
+  hooks.active_works = deps_.carries_traffic;
+  auto controller = std::make_shared<FailoverController>(
+      tunnels->Names(), options_.failover, std::move(hooks));
+  controller->Scan();
+
+  Uuid uuid = DeriveUuid(token);
+  if (!options_.uuid_override.empty()) {
+    ParseUuid(options_.uuid_override, uuid);
+  }
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    token_ = token;
+    uuid_ = uuid;
+    tunnels_ = std::move(tunnels);
+    controller_ = std::move(controller);
+  }
+  SetPhase(Phase::kReady);
+  Notify("Серверов в токене: {}", controller_->Snapshot().size());
+  return true;
+}
+
+bool App::StartVless() {
+  Uuid uuid;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    if (vless_) {
+      return true;
+    }
+    uuid = uuid_;
+  }
+  VlessServer::Config config;
+  config.listen_address = options_.listen;
+  config.port = static_cast<std::uint16_t>(options_.port);
+  config.uuid = uuid;
+  bool ok = false;
+  std::unique_ptr<VlessServer> server;
+  OnIoc([&]() {
+    server = std::make_unique<VlessServer>(ioc_, config, stack_);
+    ok = server->Start();
+    if (!ok) {
+      server.reset();
+    }
+  });
+  if (!ok) {
+    return false;
+  }
+  const std::lock_guard<std::mutex> lock(mu_);
+  vless_ = std::move(server);
+  return true;
+}
+
+bool App::ConnectTo(std::optional<std::size_t> index) {
+  std::shared_ptr<FailoverController> controller;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = controller_;
+  }
+  if (!controller) {
+    return false;
+  }
+  SetPhase(Phase::kConnecting, "Подключение к серверу...");
+  if (!controller->Start(index)) {
+    SetPhase(Phase::kReady, "Не удалось подключиться ни к одному серверу");
+    Notify("Не удалось подключиться ни к одному серверу");
+    return false;
+  }
+  controller->SetPinned(index.has_value());
+  if (!StartVless()) {
+    controller->Stop();
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      if (tunnels_) {
+        tunnels_->Shutdown();
+      }
+    }
+    const std::string text =
+        fmt::format("Порт {} занят или недоступен. Закройте другую копию "
+                    "программы или смените порт (--port).", options_.port);
+    SetPhase(Phase::kReady, text);
+    Notify("{}", text);
+    return false;
+  }
+
+  std::vector<std::string> hosts;
+  if (!options_.link_host.empty()) {
+    hosts.push_back(options_.link_host);
+  } else if (options_.listen != "0.0.0.0") {
+    hosts.push_back(options_.listen);
+  } else if (deps_.lan_hosts) {
+    hosts = deps_.lan_hosts();
+  }
+  if (hosts.empty()) {
+    hosts.push_back("127.0.0.1");
+  }
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    hosts_ = hosts;
+  }
+  SetPhase(Phase::kConnected);
+  const auto active = controller->Active();
+  const auto snapshot = controller->Snapshot();
+  if (active && *active < snapshot.size()) {
+    Notify("Подключено: {}", snapshot[*active].name);
+    SaveSettings();
+  }
+  if (deps_.full_check) {
+    const std::string summary = deps_.full_check();
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      last_check_ = summary;
+    }
+    Notify("{}", summary);
+  }
+  return true;
+}
+
+void App::SaveSettings() {
+  Settings settings;
+  std::shared_ptr<FailoverController> controller;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    if (!remember_) {
+      return;
+    }
+    settings.token = token_;
+    controller = controller_;
+  }
+  if (controller) {
+    const auto active = controller->Active();
+    const auto snapshot = controller->Snapshot();
+    if (active && *active < snapshot.size()) {
+      settings.server = snapshot[*active].name;
+    }
+    settings.pinned = controller->Pinned();
+  }
+  store_.Save(settings);
+}
+
+bool App::SubmitToken(const std::string& token, bool remember) {
+  const std::string clean = CleanToken(token);
+  if (clean.empty()) {
+    return false;
+  }
+  return Run("Разбор токена...", [this, clean, remember]() {
+    if (!Setup(clean)) {
+      return;
+    }
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      remember_ = remember;
+      token_saved_ = remember;
+    }
+    if (remember) {
+      Settings settings;
+      settings.token = clean;
+      store_.Save(settings);
+    } else {
+      store_.Clear();
+    }
+  });
+}
+
+bool App::Connect(std::optional<std::size_t> index) {
+  std::shared_ptr<FailoverController> controller;
+  bool connected = false;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = controller_;
+    connected = phase_ == Phase::kConnected;
+  }
+  if (!controller) {
+    return false;
+  }
+  if (connected) {  // already connected: this is a manual switch
+    if (!index) {
+      return false;
+    }
+    return Run("Переключение на сервер...", [this, controller, index]() {
+      if (controller->SwitchTo(*index, true)) {
+        SaveSettings();
+      }
+    });
+  }
+  return Run("Подключение...", [this, index]() { ConnectTo(index); });
+}
+
+bool App::Disconnect() {
+  return Run("Отключение...", [this]() {
+    std::shared_ptr<FailoverController> controller;
+    std::shared_ptr<ITunnels> tunnels;
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      controller = controller_;
+      tunnels = tunnels_;
+    }
+    if (controller) {
+      controller->Stop();
+    }
+    if (tunnels) {
+      tunnels->Shutdown();
+    }
+    SetPhase(Phase::kReady);
+    Notify("Отключено");
+  });
+}
+
+bool App::Rescan() {
+  std::shared_ptr<FailoverController> controller;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = controller_;
+  }
+  if (!controller) {
+    return false;
+  }
+  return Run("Замер серверов...", [controller]() { controller->Scan(); });
+}
+
+bool App::CheckTunnel() {
+  if (!deps_.full_check) {
+    return false;
+  }
+  return Run("Проверка туннеля...", [this]() {
+    const std::string summary = deps_.full_check();
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      last_check_ = summary;
+    }
+    Notify("{}", summary);
+  });
+}
+
+bool App::Unpin() {
+  std::shared_ptr<FailoverController> controller;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = controller_;
+  }
+  if (!controller) {
+    return false;
+  }
+  controller->SetPinned(false);
+  SaveSettings();
+  return true;
+}
+
+bool App::ForgetToken() {
+  return Run("Забываю токен...", [this]() {
+    Teardown(true);
+    store_.Clear();
+    {
+      const std::lock_guard<std::mutex> lock(mu_);
+      token_.clear();
+      token_saved_ = false;
+      remember_ = false;
+      hosts_.clear();
+      last_check_.clear();
+    }
+    SetPhase(Phase::kNoToken);
+    Notify("Токен удалён");
+  });
+}
+
+int App::HandlePost(const std::string& action,
+    const std::string& query,
+    const std::string& body) {
+  const auto result = [](bool ok) { return ok ? 202 : 409; };
+  if (action == "token") {
+    if (CleanToken(body).empty()) {
+      return 400;
+    }
+    return result(SubmitToken(body, query.find("remember=1") != std::string::npos));
+  }
+  if (action == "connect") {
+    if (query.find("auto=1") != std::string::npos) {
+      return result(Connect(std::nullopt));
+    }
+    if (query.rfind("i=", 0) != 0 || query.size() < 3 || query.size() > 6 ||
+        !std::all_of(query.begin() + 2, query.end(),
+            [](unsigned char c) { return std::isdigit(c) != 0; })) {
+      return 400;
+    }
+    return result(Connect(static_cast<std::size_t>(std::stoul(query.substr(2)))));
+  }
+  if (action == "disconnect") return result(Disconnect());
+  if (action == "rescan") return result(Rescan());
+  if (action == "check") return result(CheckTunnel());
+  if (action == "unpin") return result(Unpin());
+  if (action == "forget") return result(ForgetToken());
+  return 404;
+}
+
+std::string App::StateJson() {
+  nlohmann::json state;
+  std::shared_ptr<FailoverController> controller;
+  std::shared_ptr<ITunnels> tunnels;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    controller = controller_;
+    tunnels = tunnels_;
+    state["phase"] = PhaseName(static_cast<int>(phase_));
+    state["message"] = message_;
+    state["busy"] = busy_;
+    state["check"] = last_check_;
+    state["token_saved"] = token_saved_;
+    state["uuid"] = UuidToString(uuid_);
+    state["port"] = options_.port;
+    auto& links = state["links"] = nlohmann::json::array();
+    for (const auto& host : hosts_) {
+      links.push_back(
+          {{"host", host}, {"url", MakeLink(uuid_, host, options_.port)}});
+    }
+  }
+  auto& servers = state["servers"] = nlohmann::json::array();
+  int active_index = -1;
+  bool pinned = false;
+  if (controller) {
+    for (const auto& s : controller->Snapshot()) {
+      servers.push_back({{"name", s.name}, {"probed", s.probed},
+          {"ping", s.last_ping ? nlohmann::json(*s.last_ping)
+                               : nlohmann::json(nullptr)}});
+    }
+    if (const auto active = controller->Active()) {
+      active_index = static_cast<int>(*active);
+    }
+    pinned = controller->Pinned();
+  }
+  state["active_index"] = active_index;
+  state["pinned"] = pinned;
+  state["failover"] = options_.failover.failover && servers.size() > 1;
+  state["tunnel_down"] = active_index >= 0 && tunnels && tunnels->IsDown();
+  auto events = RecentEvents();
+  if (events.size() > 80) {
+    events.erase(events.begin(), events.end() - 80);
+  }
+  state["events"] = events;
+  return state.dump(-1, ' ', false, nlohmann::json::error_handler_t::replace);
+}
+
+void App::Shutdown() {
+  std::thread finished;
+  {
+    const std::lock_guard<std::mutex> lock(mu_);
+    if (shut_down_) {
+      return;
+    }
+    shut_down_ = true;
+    finished = std::move(worker_);
+  }
+  if (finished.joinable()) {
+    finished.join();  // an unfinished connect must not outlive the objects
+  }
+  Teardown(true);
+}
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/app.h b/src/fptn-vless/app.h
new file mode 100644
index 0000000..11b86b9
--- /dev/null
+++ b/src/fptn-vless/app.h
@@ -0,0 +1,132 @@
+#pragma once
+
+/*
+ * The application behind the control page. It owns the whole life cycle:
+ *
+ *   no_token -> (token) -> scanning -> ready -> connecting -> connected
+ *                              ^          ^                      |
+ *                              |          +------ disconnect ----+
+ *                              +-- forget token / new token -----+
+ *
+ * Everything the page can do is an action that runs on one worker thread
+ * (one at a time, `busy` says which); the page polls StateJson().
+ * FPTN itself is reached only through ITunnels, so this class is tested with a
+ * fake set of servers.
+ */
+
+#include <cstddef>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <boost/asio.hpp>
+
+#include "fptn-vless/failover.h"
+#include "fptn-vless/settings_store.h"
+#include "fptn-vless/tunnels.h"
+#include "fptn-vless/userspace_stack.h"
+#include "fptn-vless/vless_server.h"
+
+namespace fptn::vless {
+
+// Helpers (also used by tests).
+std::string CleanToken(const std::string& raw);  // drops spaces/newlines/quotes
+Uuid DeriveUuid(const std::string& token);       // same token -> same UUID
+std::string MakeLink(const Uuid& uuid, const std::string& host, int port);
+
+struct AppOptions {
+  FailoverController::Options failover;  // failover/scan_interval/timings
+  std::string listen = "0.0.0.0";
+  int port = 10800;
+  std::string uuid_override;   // empty: derived from the token
+  std::string link_host;       // empty: detected
+  std::string preferred_server;  // --server: connect to it (and keep it)
+};
+
+struct AppDeps {
+  // Parses the token and prepares the servers. Throws with a readable message.
+  std::function<std::unique_ptr<ITunnels>(const std::string& token)>
+      make_tunnels;
+  std::function<std::vector<std::string>()> lan_hosts;
+  // Quick yes/no: does the live tunnel carry traffic? (optional)
+  std::function<bool()> carries_traffic;
+  // Full check, returns a one-line summary. (optional)
+  std::function<std::string()> full_check;
+};
+
+class App {
+ public:
+  App(boost::asio::io_context& ioc,
+      UserspaceStack& stack,
+      SettingsStore& store,
+      AppOptions options,
+      AppDeps deps);
+  ~App();
+  App(const App&) = delete;
+  App& operator=(const App&) = delete;
+
+  // `cli_token` (from --access-token/--token-file) wins over the saved one.
+  // With a token, the program connects by itself.
+  void Start(const std::optional<std::string>& cli_token);
+
+  // Actions of the page. All return at once; false = busy or not possible now.
+  bool SubmitToken(const std::string& token, bool remember);
+  bool Connect(std::optional<std::size_t> index);  // nullopt = fastest
+  bool Disconnect();
+  bool Rescan();
+  bool CheckTunnel();
+  bool Unpin();
+  bool ForgetToken();
+
+  std::string StateJson();
+
+  // Routing of the page's POST /api/<action>: returns an HTTP-like status
+  // (202 ok, 400 bad request, 404 unknown action, 409 busy / not possible now).
+  int HandlePost(const std::string& action,
+      const std::string& query,
+      const std::string& body);
+
+  // Waits for the running action, then disconnects. Call after the io_context
+  // has stopped (or while it still runs).
+  void Shutdown();
+
+ private:
+  enum class Phase { kNoToken, kScanning, kReady, kConnecting, kConnected };
+
+  bool Run(const std::string& label, std::function<void()> action);
+  bool Setup(const std::string& token);            // worker
+  bool ConnectTo(std::optional<std::size_t> idx);  // worker
+  void Teardown(bool drop_vless);                  // worker
+  void SetPhase(Phase phase, const std::string& message = std::string());
+  void OnIoc(const std::function<void()>& fn);
+  bool StartVless();
+  void SaveSettings();
+
+  boost::asio::io_context& ioc_;
+  UserspaceStack& stack_;
+  SettingsStore& store_;
+  const AppOptions options_;
+  const AppDeps deps_;
+
+  std::mutex mu_;  // everything below
+  Phase phase_ = Phase::kNoToken;
+  std::string message_;
+  std::string busy_;
+  std::string last_check_;
+  std::string token_;
+  bool remember_ = false;
+  bool token_saved_ = false;
+  Uuid uuid_{};
+  std::vector<std::string> hosts_;
+  std::shared_ptr<ITunnels> tunnels_;
+  std::shared_ptr<FailoverController> controller_;
+  std::unique_ptr<VlessServer> vless_;
+  std::thread worker_;
+  bool shut_down_ = false;
+};
+
+}  // namespace fptn::vless
diff --git a/src/fptn-vless/dashboard.cpp b/src/fptn-vless/dashboard.cpp
new file mode 100644
index 0000000..82c08af

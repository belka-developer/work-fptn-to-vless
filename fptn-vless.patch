+else()
+  set(PLATFORM_LIBS "")
+endif()
+
+target_link_libraries(
+  "${PROJECT_NAME}"
+  PRIVATE fptn_lwip
+          ZLIB::ZLIB
+          Boost::boost
+          Boost::random
+          Boost::filesystem
+          Boost::process
+          Boost::locale
+          OpenSSL::SSL
+          OpenSSL::Crypto
+          argparse::argparse
+          nlohmann_json::nlohmann_json
+          spdlog::spdlog
+          fmt::fmt
+          libidn2::libidn2
+          re2::re2
+          fptn-protocol-lib_static
+          "${BROTLI_DEC_LIB}"
+          "${BROTLI_COMMON_LIB}"
+          ${PLATFORM_LIBS})
+
+install(TARGETS "${PROJECT_NAME}" DESTINATION bin)
+
+# --- tests (no FPTN server needed) -----------------------------------------
+option(FPTN_VLESS_BUILD_TESTS "Build the fptn-vless loopback test" ON)
